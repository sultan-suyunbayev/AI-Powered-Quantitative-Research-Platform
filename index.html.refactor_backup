                    btnCustom.className = 'px-2.5 py-1.5 rounded-lg text-white bg-blue-600 font-semibold transition-all duration-200 cursor-pointer';
                    btnAi.className = 'px-2.5 py-1.5 rounded-lg text-gray-400 hover:text-white transition-all duration-200 cursor-pointer bg-transparent';
                }
            }
            
            renderWorkflowTimeline(activeAsset);
        }

        function advanceWorkflowStep(asset, mode, job) {
            const steps = mode === 'ai' ? aiSteps : customSteps;
            const currentStep = getWorkflowProgress(asset, mode);
            
            if (currentStep < steps.length && steps[currentStep].job === job) {
                const nextStep = currentStep + 1;
                saveWorkflowProgress(asset, mode, nextStep);
                showActionToast(`Шаг ${currentStep + 1} выполнен! Переход к следующему.`);
                renderWorkflowTimeline(asset);
            } else {
                renderWorkflowTimeline(asset);
            }
        }

        function renderWorkflowTimeline(asset) {
            const container = document.getElementById('workflow-timeline');
            if (!container) return;

            const mode = quickStartMode;
            const currentStep = getWorkflowProgress(asset, mode);
            const steps = mode === 'ai' ? aiSteps : customSteps;

            container.innerHTML = '';

            const titleEl = document.getElementById('workflow-asset-title');
            const iconEl = document.getElementById('workflow-asset-icon');
            const adapterEl = document.getElementById('workflow-adapter-badge');
            
            const assetNames = {
                'equity': 'US Equities',
                'forex': 'Forex OTC',
                'futures': 'CME Futures',
                'crypto': 'Digital Assets',
                'options': 'Listed Options'
            };
            const assetIcons = {
                'equity': '<i class=\"fa-solid fa-chart-line\"></i>',
                'forex': '<i class=\"fa-solid fa-euro-sign\"></i>',
                'futures': '<i class=\"fa-solid fa-circle-nodes\"></i>',
                'crypto': '<i class=\"fa-solid fa-coins\"></i>',
                'options': '<i class=\"fa-solid fa-percent\"></i>'
            };

            if (titleEl) titleEl.innerText = assetNames[asset] || asset.toUpperCase();
            if (iconEl) iconEl.innerHTML = assetIcons[asset] || '<i class=\"fa-solid fa-gem\"></i>';
            if (adapterEl) {
                const adapter = activeAdapter || 'alpaca';
                adapterEl.innerText = adapter.toUpperCase();
            }

            steps.forEach((step, index) => {
                const stepEl = document.createElement('div');
                stepEl.className = 'relative flex gap-4 pl-6 pb-4';
                
                let iconClass = '';
                let contentClass = '';
                let actionHtml = '';

                if (index < currentStep) {
                    // Completed
                    iconClass = 'fa-circle-check text-emerald-400 bg-[#131316]';
                    contentClass = 'opacity-60';
                } else if (index === currentStep) {
                    // Active
                    iconClass = 'fa-circle-notch fa-spin text-blue-500 bg-[#131316]';
                    contentClass = 'border-l border-blue-500/20 pl-2 -ml-2 py-1';
                    actionHtml = `
                        <button class="bg-blue-600 hover:bg-blue-500 text-white text-[10px] font-medium py-1 px-3 rounded-lg transition-all active:scale-[0.98] shadow-md flex items-center gap-1.5 cursor-pointer mt-2 w-fit">
                            <span>${step.btnText}</span>
                        </button>
                    `;
                    
                    const tipTextEl = document.getElementById('workflow-tip-text');
                    if (tipTextEl) tipTextEl.innerText = step.tip;
                } else {
                    // Locked
                    iconClass = 'fa-circle text-gray-800 bg-[#131316]';
                    contentClass = 'opacity-30 pointer-events-none';
                }

                stepEl.innerHTML = `
                    <div class="absolute -left-[3px] top-1.5 z-10 flex items-center justify-center w-2 h-2 rounded-full bg-[#131316]">
                        <i class="fa-solid ${iconClass} text-xs"></i>
