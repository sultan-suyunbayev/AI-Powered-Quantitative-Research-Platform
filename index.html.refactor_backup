        // DYNAMIC QUICK START ACTIONS
        let quickActionInterval = null;
        let currentRunningJob = null;

        async function runQuickAction(cmd, payload) {
            // Clear any previous interval
            if (quickActionInterval) {
                clearInterval(quickActionInterval);
                quickActionInterval = null;
            }

            const isLite = (currentProductMode === 'lite');
            
            if (!isLite) {
                showActionToast(`Запуск фоновой задачи: ${payload.job || cmd}...`);
                let body = (cmd === 'run_job') ? { job: payload.job, params: payload.params || {} } : payload;
                try {
                    const res = await fetch(API_BASE + '/api/run_job', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify(body)
                    });
                    if (res.ok) {
                        const data = await res.json();
                        showActionToast(`Задача ${body.job} запущена (PID: ${data.pid}). Логи пишутся в ${data.log}.`);
                    } else {
                        showActionToast(`Ошибка запуска: ${res.statusText}`);
                    }
                } catch (err) {
                    showActionToast(`Ошибка: ${err.message}`);
                }
                return;
            }

            const resultPanel = document.getElementById('workflow-console-card');
            const outputPre = document.getElementById('workflow-console-output');

            if (resultPanel && outputPre) {
                resultPanel.classList.remove('hidden');
                outputPre.innerText = "Инициализация задачи...\n";
                
                let body = {};
                if (cmd === 'run_job') {
                    body = {
                        job: payload.job,
                        params: payload.params || {}
                    };
                } else {
                    body = payload;
                }

                // Hide evaluation results panel at start of action
                const evalCard = document.getElementById('workflow-eval-card');
                if (evalCard) evalCard.classList.add('hidden');

                try {
                    const res = await fetch(API_BASE + '/api/run_job', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify(body)
                    });

                    if (!res.ok) {
                        const errData = await res.json();
                        outputPre.innerText += `Ошибка запуска: ${errData.detail || 'Неизвестная ошибка'}\n`;
                        currentRunningJob = null;
                        renderPipelineStatusDetails(activeAsset);
                        return;
                    }

                    const data = await res.json();
                    const logFile = data.log;
                    const pid = data.pid;
                    outputPre.innerText += `Задача успешно запущена (PID: ${pid}). Чтение логов...\n\n`;

                    currentRunningJob = body.job;
                    renderPipelineStatusDetails(activeAsset);

                    if (logFile) {
                        const logName = logFile.split('/').pop();
                        let pollCount = 0;
                        quickActionInterval = setInterval(async () => {
                            try {
                                const logRes = await fetch(API_BASE + '/api/logs?name=' + logName);
                                if (logRes.ok) {
                                    const text = await logRes.text();
                                    outputPre.innerText = text || "Ожидание записей в лог...";
                                    outputPre.scrollTop = outputPre.scrollHeight;
                                }

                                // Check status for this specific job
                                const statusRes = await fetch(API_BASE + '/api/job/status?job=' + body.job);
                                if (statusRes.ok) {
                                    const statusData = await statusRes.json();
                                    if (!statusData.running) {
                                        clearInterval(quickActionInterval);
                                        quickActionInterval = null;
                                        currentRunningJob = null;
                                        
                                        if (body.job === 'run_eval') {
                                            // Load evaluation curve in the workflow card
                                            const wfChartImg = document.getElementById('workflow-eval-chart');
                                            const wfSpinner = document.getElementById('workflow-eval-spinner');
                                            const wfEvalCard = document.getElementById('workflow-eval-card');
                                            
                                            if (wfEvalCard) wfEvalCard.classList.remove('hidden');
                                            if (wfSpinner) wfSpinner.classList.remove('hidden');
                                            if (wfChartImg) {
                                                wfChartImg.classList.add('opacity-0');
                                                wfChartImg.src = API_BASE + '/api/image?path=logs/equity.png&t=' + new Date().getTime();
                                                wfChartImg.onload = () => {
                                                    if (wfSpinner) wfSpinner.classList.add('hidden');
                                                    wfChartImg.classList.remove('opacity-0');
                                                };
                                                wfChartImg.onerror = () => {
                                                    if (wfSpinner) wfSpinner.classList.add('hidden');
                                                };
                                            }
                                        }

                                        // Auto-advance step in Lite mode
                                        advanceWorkflowStep(activeAsset, quickStartMode, body.job);
                                        return;
                                    }
                                }
                            } catch (err) {
                                console.error("Error polling quick action logs:", err);
                            }
                            
                            pollCount++;
                            if (pollCount > 180) { // extended limit
                                clearInterval(quickActionInterval);
                                quickActionInterval = null;
                                currentRunningJob = null;
                                renderPipelineStatusDetails(activeAsset);
                            }
                        }, 1000);
                    }
                } catch (err) {
                    outputPre.innerText += `Сетевая ошибка: ${err.message}\n`;
                    currentRunningJob = null;
                    renderPipelineStatusDetails(activeAsset);
                }
            }
        }


