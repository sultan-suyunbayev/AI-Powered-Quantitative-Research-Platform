        function switchWorkflowMode(mode) {
            quickStartMode = mode;
            const btnAi = document.getElementById('workflow-toggle-ai');
            const btnCustom = document.getElementById('workflow-toggle-custom');
            
            if (btnAi && btnCustom) {
                if (mode === 'ai') {
                    btnAi.className = 'px-2.5 py-1.5 rounded-lg text-white bg-blue-600 font-semibold transition-all duration-200 cursor-pointer';
