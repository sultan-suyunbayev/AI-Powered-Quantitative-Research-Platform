                        document.getElementById('liteagents-ece-val').innerHTML = `<span class="text-amber-400 font-bold">${beforeEce}</span> → <span class="text-emerald-400 font-bold">${afterEce}</span>`;
                        document.getElementById('liteagents-brier-val').innerHTML = `<span class="text-gray-500">${beforeBrier}</span> → <span class="text-emerald-400 font-bold">${afterBrier}</span>`;
                    }
                }
                
                // Read calibrator weights and draw curve
                const modelRes = await fetch(API_BASE + `/api/json/get_file?path=models/calibrator.json`);
