            if (currentProductMode === 'lite') {
                // Show progress UI in modal
                document.getElementById('paper-setup-container').classList.add('hidden');
                const progressContainer = document.getElementById('paper-progress-container');
                progressContainer.classList.remove('hidden');

                const logText = document.getElementById('paper-log-text');
                const logScroll = document.getElementById('paper-log-scroll');
                const statusText = document.getElementById('paper-status-text');
                const elapsedSpan = document.getElementById('paper-elapsed');
                const loaderIcon = document.getElementById('paper-loader-icon');
                const resultsCard = document.getElementById('paper-results-card');
                const cancelBtn = document.getElementById('paper-cancel-btn');
                const closeBtn = document.getElementById('paper-close-btn');

                logText.innerText = "Запуск тестовой торговли (Paper Trading)...\n";
                statusText.innerText = "Выполняется демо-торговля (Paper Trading)...";
                statusText.className = "text-xs text-pink-400 font-mono font-medium";
                loaderIcon.classList.remove('hidden');
                resultsCard.classList.add('hidden');
                cancelBtn.classList.remove('hidden');
                closeBtn.classList.add('hidden');

                let startTime = Date.now();
                elapsedSpan.innerText = "00:00";
                if (window.paperTimerInterval) clearInterval(window.paperTimerInterval);
                window.paperTimerInterval = setInterval(() => {
                    let sec = Math.floor((Date.now() - startTime) / 1000);
                    let m = String(Math.floor(sec / 60)).padStart(2, '0');
                    let s = String(sec % 60).padStart(2, '0');
                    elapsedSpan.innerText = `${m}:${s}`;
                    document.getElementById('paper-res-runtime').innerText = `${m}:${s}`;
                }, 1000);

                if (quickActionInterval) {
                    clearInterval(quickActionInterval);
                    quickActionInterval = null;
                }

                try {
                    const res = await fetch(API_BASE + '/api/run_job', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({
                            job: '/start',
                            params: {
                                is_custom_strategy: true,
                                paper: true,
                                symbols: symbol,
                                strategy_params: {
                                    order_qty: parseFloat(qty)
                                },
                                use_optimized_params: useOptimizedParamsMap[activeAsset] || false
                            }
                        })
                    });

                    if (!res.ok) {
                        if (window.paperTimerInterval) {
                            clearInterval(window.paperTimerInterval);
                            window.paperTimerInterval = null;
                        }
                        const errData = await res.json();
                        logText.innerText += `Ошибка запуска: ${errData.detail || 'Неизвестная ошибка'}\n`;
                        statusText.innerText = "Ошибка запуска";
                        statusText.className = "text-xs text-red-400 font-mono font-medium";
                        loaderIcon.classList.add('hidden');
                        cancelBtn.classList.add('hidden');
                        closeBtn.classList.remove('hidden');
                        return;
                    }

                    const data = await res.json();
                    const pid = data.pid;
                    logText.innerText += `Тестовая торговля успешно запущена в фоне (PID: ${pid}). Чтение логов...\n\n`;
                    logScroll.scrollTop = logScroll.scrollHeight;

                    // Display dynamic stats card
                    resultsCard.classList.remove('hidden');
                    let signalCount = 0;
                    let currentPosition = "FLAT";
                    document.getElementById('paper-res-position').innerText = currentPosition;
                    document.getElementById('paper-res-signals').innerText = signalCount;

                    let pollCount = 0;
                    quickActionInterval = setInterval(async () => {
                        try {
                            const logRes = await fetch(API_BASE + '/api/logs?name=realtime.log');
                            if (logRes.ok) {
                                const text = await logRes.text();
                                logText.innerText = text || "Ожидание записей в лог...";
                                logScroll.scrollTop = logScroll.scrollHeight;

                                // Parse signals and position from logs dynamically
                                if (text) {
                                    const signalMatches = text.match(/decide\s+returning|signal\s+generated|executing\s+order/gi);
                                    if (signalMatches) {
                                        signalCount = signalMatches.length;
                                        document.getElementById('paper-res-signals').innerText = signalCount;
                                    }
                                    if (text.toLowerCase().includes("buy") || text.toLowerCase().includes("long")) {
                                        currentPosition = "LONG";
                                        document.getElementById('paper-res-position').innerText = currentPosition;
                                        document.getElementById('paper-res-position').className = "text-emerald-400 font-semibold font-mono";
                                    } else if (text.toLowerCase().includes("sell") || text.toLowerCase().includes("short")) {
                                        currentPosition = "SHORT";
                                        document.getElementById('paper-res-position').innerText = currentPosition;
                                        document.getElementById('paper-res-position').className = "text-red-400 font-semibold font-mono";
                                    }
                                }
                            }

                            const statusRes = await fetch(API_BASE + '/api/job/status?job=rt_signaler');
                            if (statusRes.ok) {
                                const statusData = await statusRes.json();
                                if (!statusData.running) {
                                    clearInterval(quickActionInterval);
                                    quickActionInterval = null;
                                    if (window.paperTimerInterval) {
                                        clearInterval(window.paperTimerInterval);
                                        window.paperTimerInterval = null;
                                    }

                                    logText.innerText += `\nДемо-торговля остановлена.\n`;
                                    logScroll.scrollTop = logScroll.scrollHeight;
                                    statusText.innerText = "Тестовый запуск завершен";
                                    statusText.className = "text-xs text-gray-400 font-mono font-medium";
                                    loaderIcon.classList.add('hidden');
                                    cancelBtn.classList.add('hidden');
                                    closeBtn.classList.remove('hidden');
                                }
                            }
                        } catch (err) {
                            console.error("Error polling paper trading logs:", err);
                        }

                        pollCount++;
                        if (pollCount > 300) {
                            clearInterval(quickActionInterval);
                            quickActionInterval = null;
                            if (window.paperTimerInterval) {
                                clearInterval(window.paperTimerInterval);
                                window.paperTimerInterval = null;
                            }
                            statusText.innerText = "Таймаут выполнения";
                            statusText.className = "text-xs text-yellow-400 font-mono font-medium";
                            loaderIcon.classList.add('hidden');
                            cancelBtn.classList.add('hidden');
                            closeBtn.classList.remove('hidden');
                            logText.innerText += "\n[Предупреждение] Превышен таймаут отслеживания демо-торговли (5 мин).\n";
                            logScroll.scrollTop = logScroll.scrollHeight;
                        }
                    }, 1000);
                } catch (err) {
                    if (window.paperTimerInterval) {
                        clearInterval(window.paperTimerInterval);
                        window.paperTimerInterval = null;
                    }
                    logText.innerText += `Сетевая ошибка: ${err.message}\n`;
                    statusText.innerText = "Сетевая ошибка";
                    statusText.className = "text-xs text-red-400 font-mono font-medium";
                    loaderIcon.classList.add('hidden');
                    cancelBtn.classList.add('hidden');
                    closeBtn.classList.remove('hidden');
                }
            } else {
                executeProTerminalCommand(`python script_live.py --asset ${activeAsset} --symbol ${symbol} --qty ${qty} --paper-mode`);
                closePaperTradingModal();
            }
        }

