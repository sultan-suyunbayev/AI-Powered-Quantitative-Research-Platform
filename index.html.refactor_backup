        function filterSidebarModules() {
            const query = document.getElementById('sidebar-search').value.toLowerCase();
            const blocks = document.querySelectorAll('.category-block');
            blocks.forEach(block => {
                const catName = block.getAttribute('data-category').toLowerCase();
                const buttons = block.querySelectorAll('button');
                let catMatch = catName.includes(query);
                let anyButtonVisible = false;

                buttons.forEach(btn => {
                    const btnText = btn.innerText.toLowerCase();
                    if (catMatch || btnText.includes(query)) {
                        btn.style.display = 'block';
                        anyButtonVisible = true;
                    } else {
                        btn.style.display = 'none';
                    }
                });

                if (anyButtonVisible) {
                    block.style.display = 'block';
                } else {
                    block.style.display = 'none';
                }
            });
        }

