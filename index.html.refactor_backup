        function switchLiteDataStep(stepNum) {
            currentLiteDataStep = stepNum;
            
            // Update Stepper Headers indicator classes
            for (let i = 1; i <= 4; i++) {
                const ind = document.getElementById(`step-ind-${i}`);
                if (ind) {
                    if (i === stepNum) {
                        ind.className = "flex items-center gap-1.5 cursor-pointer text-sky-400 font-semibold";
                        const dot = ind.querySelector('span');
                        if (dot) dot.className = "w-5 h-5 rounded-full bg-sky-500/20 border border-sky-500/40 flex items-center justify-center font-bold";
                    } else {
                        ind.className = "flex items-center gap-1.5 cursor-pointer text-gray-500 hover:text-gray-400";
                        const dot = ind.querySelector('span');
                        if (dot) dot.className = "w-5 h-5 rounded-full bg-[#1A1A22] border border-[#2B2B36] flex items-center justify-center font-bold";
                    }
                }
            }

            // Toggle panels
            for (let i = 1; i <= 4; i++) {
                const panel = document.getElementById(`litedata-panel-step${i}`);
                if (panel) {
                    if (i === stepNum) {
                        panel.classList.remove('hidden');
                    } else {
                        panel.classList.add('hidden');
                    }
                }
            }

            // Update footer controls
            document.getElementById('litedata-step-curr').innerText = stepNum;
            document.getElementById('litedata-btn-back').disabled = (stepNum === 1);
            document.getElementById('litedata-btn-next').disabled = (stepNum === 4);
        }

        function navigateLiteDataStep(offset) {
            const nextStep = currentLiteDataStep + offset;
            if (nextStep >= 1 && nextStep <= 4) {
                switchLiteDataStep(nextStep);
            }
        }

