                                            const maxdd = bestMetrics.max_drawdown !== undefined ? bestMetrics.max_drawdown : 0;
                                            const ret = bestMetrics.total_return !== undefined ? bestMetrics.total_return : 0;
                                            const trades = best.trades_count !== undefined ? best.trades_count : 0;

