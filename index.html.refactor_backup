        async function fetchRiskLimitsDefaults() {
            try {
                // Get settings from active asset risk config (falls back to risk.yaml or sim.yaml)
                const configPath = "configs/risk.yaml";
                const res = await fetch(API_BASE + `/api/yaml/get?path=${configPath}`);
                if (res.ok) {
                    const yamlData = await res.json();
                    const text = yamlData.content || "";
                    
                    // Simple regex parses
                    const notionalMatch = text.match(/max_total_notional:\s*([0-9.]+)/);
                    const pctMatch = text.match(/max_total_exposure_pct:\s*([0-9.]+)/);
                    const bufferMatch = text.match(/exposure_buffer_frac:\s*([0-9.]+)/);
                    
                    const concentration = document.getElementById('liteport-limit-concentration');
                    if (concentration && pctMatch) {
                        concentration.value = Math.round(parseFloat(pctMatch[1]) * 100);
                    }
                }
            } catch (err) {
                console.error("Error reading risk overrides:", err);
            }
        }

        async function saveRiskLimits() {
            showActionToast('Сохранение конфигурации лимитов рисков...');
            const dailyLoss = parseFloat(document.getElementById('liteport-limit-daily-loss').value || 1000);
            const maxDd = parseInt(document.getElementById('liteport-limit-max-dd').value || 15);
            const leverage = parseFloat(document.getElementById('liteport-limit-leverage').value || 2.0);
            const concentration = parseFloat(document.getElementById('liteport-limit-concentration').value || 25);
            
            try {
                const configPath = "configs/risk.yaml";
                const yamlDataRes = await fetch(API_BASE + `/api/yaml/get?path=${configPath}`);
                if (!yamlDataRes.ok) {
                    showActionToast('❌ Не удалось получить файл риск-лимитов.');
                    return;
                }
                const data = await yamlDataRes.json();
                let content = data.content;
                
                // Update properties in content string
                content = content.replace(/max_total_exposure_pct:\s*[0-9.a-zA-Z]+/g, `max_total_exposure_pct: ${(concentration / 100).toFixed(2)}`);
                
                const saveRes = await fetch(API_BASE + `/api/yaml/save`, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        path: configPath,
                        content: content
                    })
                });
                
                if (saveRes.ok) {
                    showActionToast('✅ Новые лимиты рисков сохранены и применены в configs/risk.yaml!');
                } else {
                    showActionToast('❌ Ошибка сохранения лимитов.');
                }
            } catch (err) {
                showActionToast('❌ Сетевая ошибка при сохранении: ' + err.message);
            }
        }

