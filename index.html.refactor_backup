        function switchProductMode(mode) {
            currentProductMode = mode;
            const btnLite = document.getElementById('toggle-mode-lite');
            const btnPro = document.getElementById('toggle-mode-pro');
            const slider = document.getElementById('product-mode-slider');

            if (!btnLite || !btnPro) return;

            const homeLite = document.getElementById('home-lite-content');
            const homePro = document.getElementById('home-pro-content');
            const moduleHome = document.getElementById('module-home');

            const liteNav = document.getElementById('lite-nav-container');

            if (mode === 'lite') {
                if (slider) slider.style.transform = 'translateX(0)';
                btnLite.classList.add('text-white', 'font-semibold');
                btnLite.classList.remove('text-gray-400');
                btnPro.classList.add('text-gray-400');
                btnPro.classList.remove('text-white', 'font-semibold');

                // Show Lite Sidebar Navigation
                if (liteNav) {
                    liteNav.classList.remove('hidden');
                    liteNav.classList.add('flex');
                }

                // Show Lite home screen content & Hide Pro home screen content
                if (homeLite) homeLite.classList.remove('hidden');
                if (homePro) homePro.classList.add('hidden');
                if (moduleHome) {
                    moduleHome.classList.add('my-auto');
                    moduleHome.classList.remove('my-0');
                }

                // Hide search filter
                const searchBlock = document.getElementById('sidebar-search')?.closest('.relative');
                if (searchBlock) searchBlock.classList.add('hidden');

                // Hide categories
                const categories = document.querySelectorAll('.category-block');
                categories.forEach(el => el.classList.add('hidden'));

                // Go to home module
                switchModule('home');
            } else {
                if (slider) slider.style.transform = 'translateX(100%)';
                btnPro.classList.add('text-white', 'font-semibold');
                btnPro.classList.remove('text-gray-400');
                btnLite.classList.add('text-gray-400');
                btnLite.classList.remove('text-white', 'font-semibold');

                // Hide Lite Sidebar Navigation
                if (liteNav) {
                    liteNav.classList.add('hidden');
                    liteNav.classList.remove('flex');
                }

                // Hide Lite home screen content & Show Pro home screen content
                if (homeLite) homeLite.classList.add('hidden');
                if (homePro) homePro.classList.remove('hidden');
                if (moduleHome) {
                    moduleHome.classList.remove('my-auto');
                    moduleHome.classList.add('my-0');
                }

                // Show search filter
                const searchBlock = document.getElementById('sidebar-search')?.closest('.relative');
                if (searchBlock) searchBlock.classList.remove('hidden');

                // Show categories
                const categories = document.querySelectorAll('.category-block');
                categories.forEach(el => el.classList.remove('hidden'));
                
                // Update terminal path display
                updateTerminalPathUI();
            }
        }

        // --- Claude Code CLI Terminal Core Functions ---
        let terminalLogInterval = null;
        let lastLogLength = 0;
        let terminalCwd = ''; // Tracks active directory of the terminal
        let terminalActiveCmdId = null; // Tracks current running command ID
        let cliHistory = [];
        try {
            cliHistory = JSON.parse(localStorage.getItem('rivenquant_cli_history') || '[]');
        } catch (e) {
            cliHistory = [];
        }
        let cliHistoryIndex = -1;

        function appendToProTerminal(htmlText) {
            const screen = document.getElementById('pro-terminal-screen');
            if (!screen) return;
            const line = document.createElement('div');
            line.innerHTML = htmlText;
            screen.appendChild(line);
            
            // Check if user is scrolled to near bottom before auto-scrolling
            const isScrolledToBottom = screen.scrollHeight - screen.clientHeight <= screen.scrollTop + 50;
            if (isScrolledToBottom || !terminalActiveCmdId) {
                screen.scrollTop = screen.scrollHeight;
            }
        }

        function updateTerminalPathUI() {
            const el = document.getElementById('pro-terminal-header-path');
            if (!el) return;
            if (!terminalCwd) {
                el.innerText = 'claude-code@rivenquant:~/startup';
            } else {
                let folder = terminalCwd;
                if (folder.includes('\\')) {
                    const parts = folder.split('\\');
                    folder = parts[parts.length - 1] || folder;
                } else if (folder.includes('/')) {
                    const parts = folder.split('/');
                    folder = parts[parts.length - 1] || folder;
                }
                el.innerText = `claude-code@rivenquant:~/${folder}`;
            }
        }

        function stopTerminalExecution(exitCode) {
            if (terminalLogInterval) {
                clearInterval(terminalLogInterval);
                terminalLogInterval = null;
            }
            terminalActiveCmdId = null;
            
            const input = document.getElementById('pro-cli-input');
            if (input) {
                input.removeAttribute('disabled');
                input.placeholder = "Введите команду CLI... (help, check-guards, config --list)";
                input.focus();
            }
            
            const termBadge = document.getElementById('pro-terminal-running-badge');
            if (termBadge) termBadge.classList.add('hidden');
            
            if (exitCode !== undefined && exitCode !== null) {
                if (exitCode === 0) {
                    appendToProTerminal(`<div class="text-emerald-500 font-mono mt-1">[CLI] Процесс завершен (код 0).</div>`);
                } else {
                    appendToProTerminal(`<div class="text-red-400 font-mono mt-1">[CLI] Процесс завершен с ошибкой (код ${exitCode}).</div>`);
                }
            }
            appendToProTerminal(`<div class="flex gap-2"><span class="text-purple-400">$</span><span class="animate-pulse">_</span></div>`);
            
            const screen = document.getElementById('pro-terminal-screen');
            if (screen) screen.scrollTop = screen.scrollHeight;
        }

        async function killActiveTerminalCommand() {
            if (!terminalActiveCmdId) return;
            appendToProTerminal(`<div class="text-red-400 pl-4 font-mono">[CLI] Прерывание выполнения процесса (SIGINT)...</div>`);
            try {
                const res = await fetch(API_BASE + `/api/terminal/kill?cmd_id=${terminalActiveCmdId}`, { method: 'POST' });
                if (res.ok) {
                    appendToProTerminal(`<div class="text-red-500 pl-4 font-mono">[CLI] Процесс успешно прибит.</div>`);
                }
            } catch (err) {
                console.error("Error killing terminal process:", err);
            }
            stopTerminalExecution(1);
        }

        function startTerminalLogStream(logName) {
            if (terminalLogInterval) {
                clearInterval(terminalLogInterval);
            }
            lastLogLength = 0;
            
            const fetchNewLogs = async () => {
                try {
                    const res = await fetch(API_BASE + `/api/logs?name=${logName}`);
                    if (!res.ok) return;
                    const text = await res.text();
                    if (text.length > lastLogLength) {
                        const newText = text.substring(lastLogLength);
                        lastLogLength = text.length;
                        const escapedText = newText
                            .replace(/&/g, "&amp;")
                            .replace(/</g, "&lt;")
                            .replace(/>/g, "&gt;")
                            .replace(/"/g, "&quot;")
                            .replace(/'/g, "&#039;")
                            .replace(/\n/g, '<br>');
                        appendToProTerminal(`<span class="text-gray-400 font-mono text-[11px] leading-relaxed">${escapedText}</span>`);
                    }
                    
                    if (terminalActiveCmdId) {
                        const statusRes = await fetch(API_BASE + `/api/terminal/status?cmd_id=${terminalActiveCmdId}`);
                        if (statusRes.ok) {
                            const statusData = await statusRes.json();
                            if (!statusData.running) {
                                stopTerminalExecution(statusData.exit_code);
                            }
                        }
                    }
                } catch (err) {
                    console.error("Error streaming CLI logs:", err);
                }
            };
            
            fetchNewLogs();
            terminalLogInterval = setInterval(fetchNewLogs, 250); // fast polling interval (250ms)
        }

        function runProCLI(cmdName) {
            let cmdStr = '';
            if (cmdName === 'status') {
                cmdStr = 'rivenquant status';
            } else if (cmdName === 'backtest') {
                cmdStr = 'rivenquant backtest';
            } else if (cmdName === 'train') {
                cmdStr = 'rivenquant train';
            } else if (cmdName === 'tree') {
                cmdStr = 'rivenquant tree';
            } else if (cmdName === 'clear') {
                cmdStr = 'clear';
            }
            executeCLICommand(cmdStr);
        }

        function handleProCLIKeydown(e) {
            const input = document.getElementById('pro-cli-input');
            if (!input) return;
            if (e.key === 'Enter') {
                submitProCLI();
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                if (cliHistory.length === 0) return;
                if (cliHistoryIndex < cliHistory.length - 1) {
                    cliHistoryIndex++;
                    input.value = cliHistory[cliHistoryIndex];
                }
            } else if (e.key === 'ArrowDown') {
                e.preventDefault();
                if (cliHistoryIndex > 0) {
                    cliHistoryIndex--;
                    input.value = cliHistory[cliHistoryIndex];
                } else if (cliHistoryIndex === 0) {
                    cliHistoryIndex = -1;
                    input.value = '';
                }
            } else if (e.key === 'c' && e.ctrlKey) {
                if (terminalActiveCmdId) {
                    e.preventDefault();
                    killActiveTerminalCommand();
                }
            }
        }

        function submitProCLI() {
            const input = document.getElementById('pro-cli-input');
            if (!input) return;
            const cmd = input.value.trim();
            if (!cmd) return;
            
            cliHistory = cliHistory.filter(c => c !== cmd);
            cliHistory.unshift(cmd);
            if (cliHistory.length > 50) cliHistory.pop();
            localStorage.setItem('rivenquant_cli_history', JSON.stringify(cliHistory));
            cliHistoryIndex = -1;
            
            executeCLICommand(cmd);
            input.value = '';
        }

        async function executeCLICommand(cmdLine) {
            const cleanCmd = cmdLine.trim();
            if (!cleanCmd) return;
            
            if (terminalLogInterval) {
                clearInterval(terminalLogInterval);
                terminalLogInterval = null;
            }

            // Print command line to screen
            appendToProTerminal(`<div class="flex gap-2"><span class="text-purple-400">$</span><span>${cleanCmd}</span></div>`);
            
            const args = cleanCmd.split(' ');
            const primary = args[0].toLowerCase();
            
            if (primary === 'clear' || primary === 'cls') {
                const screen = document.getElementById('pro-terminal-screen');
                if (screen) screen.innerHTML = '';
                appendToProTerminal(`<div class="text-gray-500">RivenQuant CLI Shell. Type command or choose action.</div>`);
                appendToProTerminal(`<div class="flex gap-2"><span class="text-purple-400">$</span><span class="animate-pulse">_</span></div>`);
                return;
            }
            
            if (primary === 'help') {
