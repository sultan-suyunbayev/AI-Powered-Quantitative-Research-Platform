        function submitTrainingTableConfig() {
            try {
                const asset = activeAsset;
                
                const baseEl = document.getElementById('train-table-base');
                const pricesEl = document.getElementById('train-table-prices');
                const priceColEl = document.getElementById('train-table-price-col');
                const delayEl = document.getElementById('train-table-delay');
                const outEl = document.getElementById('train-table-out');
                const horizonEl = document.getElementById('train-table-horizon-ms');
                const returnsEl = document.getElementById('train-table-returns');
                const sourcesEl = document.getElementById('train-table-sources');

                const missing = [];
                if (!baseEl) missing.push('train-table-base');
                if (!pricesEl) missing.push('train-table-prices');
                if (!priceColEl) missing.push('train-table-price-col');
                if (!delayEl) missing.push('train-table-delay');
                if (!outEl) missing.push('train-table-out');
                if (!horizonEl) missing.push('train-table-horizon-ms');
                if (!returnsEl) missing.push('train-table-returns');
                if (!sourcesEl) missing.push('train-table-sources');

                if (missing.length > 0) {
                    throw new Error("Не найдены элементы: " + missing.join(', '));
                }

                const base = baseEl.value;
                const prices = pricesEl.value;
                const price_col = priceColEl.value;
                const delay = parseInt(delayEl.value) || 0;
                const out = outEl.value;
                const horizon_ms = parseInt(horizonEl.value) || 14400000;
                const returns = returnsEl.value;
                const sources = sourcesEl.value;

                const params = {
                    base: base,
                    prices: prices,
                    price_col: price_col,
                    decision_delay_ms: delay,
                    out: out,
                    label_horizon_ms: horizon_ms,
                    label_returns: returns
                };

                if (sources && sources.trim()) {
                    params.sources = sources;
                }

                // Save to localStorage for dynamic telemetry tracking
                try {
                    localStorage.setItem('rivenquant_config_train_table_' + asset, JSON.stringify(params));
                } catch (e) {
                    console.error("Error saving train table params:", e);
                }

                closeTrainingTableConfig();

                runQuickAction('run_job', {
                    job: 'run_training_table',
                    params: params
                });
            } catch (err) {
                console.error("Error in submitTrainingTableConfig:", err);
                alert("Ошибка при запуске сборки: " + err.message);
            }
        }

