            btnStop.removeAttribute('disabled');
            btnStop.classList.remove('opacity-50', 'cursor-not-allowed');
            
            const consoleEl = document.getElementById('quantlab-train-console');
            consoleEl.innerText = "Запуск обучения RL-агента...";
            quantlabTrainLastLength = 0;
            
            try {
                const res = await fetch(API_BASE + '/api/run_job', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        job: 'run_train',
                        params: {
                            total_timesteps: timesteps,
                            learning_rate: lr,
                            n_envs: envs,
                            initial_cash: document.getElementById('quantlab-sim-cash').value,
                            
                            // Advanced hyperparameters:
                            gamma: document.getElementById('quantlab-train-gamma').value,
                            gae_lambda: document.getElementById('quantlab-train-gae-lambda').value,
                            batch_size: document.getElementById('quantlab-train-batch-size').value,
                            turnover_penalty: document.getElementById('quantlab-train-turnover-penalty').value,
                            calendar: document.getElementById('quantlab-train-calendar').value,
                            min_adv: document.getElementById('quantlab-train-min-adv').value
                        }
                    })
                });
                
                if (res.ok) {
                    const data = await res.json();
                    showActionToast(`Процесс обучения запущен. PID: ${data.pid}`);
                    
                    if (quantlabTrainInterval) clearInterval(quantlabTrainInterval);
                    
                    quantlabTrainInterval = setInterval(async () => {
                        try {
                            const logRes = await fetch(API_BASE + `/api/logs?name=run_train`);
                            if (!logRes.ok) return;
                            const text = await logRes.text();
                            if (text.length > quantlabTrainLastLength) {
                                quantlabTrainLastLength = text.length;
                                consoleEl.innerText = text;
                                consoleEl.scrollTop = consoleEl.scrollHeight;
                            }
                        } catch (e) {
                            console.error("Error fetching train logs:", e);
                        }
                    }, 1000);
                } else {
                    const errText = await res.text();
                    consoleEl.innerText = `Ошибка запуска: ${errText}`;
                    stopQuantLabTraining();
                }
            } catch (err) {
                consoleEl.innerText = `Сетевая ошибка: ${err.message}`;
                stopQuantLabTraining();
            }
        }

