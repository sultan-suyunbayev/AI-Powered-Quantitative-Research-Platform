            showActionToast("Сохранение и проверка компиляции...");
            
            try {
                const res = await fetch(API_BASE + '/api/save_strategy', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        asset: activeAsset,
                        template_name: "custom",
                        code: code,
                        params: params
                    })
                });
                
                const data = await res.json();
                banner.classList.remove('hidden');
                
                if (res.ok) {
