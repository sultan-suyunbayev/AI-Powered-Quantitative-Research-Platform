        async function coderSaveStrategy() {
            const code = getCoderCode();
            const paramsStr = document.getElementById('coder-params-json').value;
            let params = {};
            
            const banner = document.getElementById('coder-status-banner');
            banner.classList.add('hidden');
            
            try {
