        async function saveAndCompileStrategy() {
            const editor = document.getElementById('strategy-code-editor');
            const statusEl = document.getElementById('save-strategy-status');
            if (!editor || !statusEl) return;

            statusEl.className = "text-xs font-mono mr-auto self-center text-blue-400";
            statusEl.innerText = "Компиляция...";

            const params = {};
            const inputs = document.querySelectorAll('#strategy-params-inputs input');
            inputs.forEach(inp => {
                const key = inp.getAttribute('data-param-key');
                params[key] = isNaN(inp.value) ? inp.value : parseFloat(inp.value);
            });

            try {
                const res = await fetch(API_BASE + '/api/save_strategy', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        asset: activeAsset,
                        code: editor.value,
                        params: params
                    })
                });
                
                if (res.ok) {
                    // Save to localStorage for dynamic telemetry tracking
                    try {
                        localStorage.setItem('rivenquant_config_code_' + activeAsset, JSON.stringify({
                            params: params,
                            code_length: editor.value.length
                        }));
                    } catch (e) {
                        console.error("Error saving strategy params:", e);
                    }

                    statusEl.className = "text-xs font-mono mr-auto self-center text-emerald-400";
                    statusEl.innerText = "Успешно сохранено и скомпилировано!";
                    showActionToast("Стратегия сохранена!");
                    if (currentProductMode === 'lite' && quickStartMode === 'custom') {
                        advanceWorkflowStep(activeAsset, 'custom', 'strategy_save');
                    }
                    setTimeout(() => closeStrategyCodingModal(), 1000);
                } else {
                    const err = await res.json();
                    statusEl.className = "text-xs font-mono mr-auto self-center text-red-400";
                    statusEl.innerText = `Ошибка: ${err.detail || 'Не удалось скомпилировать'}`;
                }
            } catch (err) {
                statusEl.className = "text-xs font-mono mr-auto self-center text-red-400";
                statusEl.innerText = `Ошибка сети: ${err.message}`;
            }
        }

