        // Close individual position
        async function closePosition(symbol) {
            if (!confirm(`Вы действительно хотите принудительно закрыть позицию по ${symbol}?`)) {
                return;
            }
            try {
                const res = await fetch(API_BASE + '/api/portfolio/close', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({symbol: symbol})
                });
                if (res.ok) {
                    showActionToast(`Заявка на закрытие позиции по ${symbol} отправлена.`);
                    fetchHoldings();
                } else {
                    const data = await res.json();
                    showActionToast(`Ошибка: ${data.detail || res.statusText}`);
                }
            } catch (err) {
                showActionToast(`Ошибка: ${err.message}`);
            }
        }

        // Emergency Panic Halt
        async function triggerPanicHalt() {
            if (!confirm("Внимание! Вы собираетесь активировать EMERGENCY PANIC HALT. Будут закрыты все позиции и остановлена автоматическая торговля. Продолжить?")) {
                return;
            }
            try {
                const res = await fetch(API_BASE + '/api/panic_halt', {
                    method: 'POST'
                });
