                const includeSpread = document.getElementById('ingest-include-spread').checked;
                const sessionLabels = document.getElementById('ingest-session-labels').checked;
                const force = document.getElementById('ingest-force').checked;
                
                custom_config = {
                    symbols: symbols,
                    provider: provider,
                    timeframe: timeframe,
                    period: { start: start, end: end },
                    api_key: apiKey,
                    account_id: accountId,
                    live: !practice,
