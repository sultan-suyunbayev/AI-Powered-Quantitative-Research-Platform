        async function previewLiteDataFile(path) {
            const tbody = document.getElementById('litedata-preview-tbody');
            const totalCountEl = document.getElementById('litedata-preview-rows-count');
            const table = document.getElementById('litedata-preview-table');
            if (!tbody || !totalCountEl || !table) return;

            tbody.innerHTML = `<tr><td colspan="4" class="py-4 text-center text-gray-500"><i class="fa-solid fa-spinner fa-spin mr-1"></i> Чтение файла...</td></tr>`;
            
            try {
                const res = await fetch(API_BASE + `/api/data/preview?path=${path}&n=15`);
                if (!res.ok) {
                    throw new Error(await res.text());
                }
                
                const data = await res.json();
                totalCountEl.innerText = `${data.total_rows.toLocaleString()} строк всего`;
                
                // Redraw table headers based on columns
                const thead = table.querySelector('thead');
                const showCols = data.columns.slice(0, 5); // Show max 5 columns for layout beauty
                thead.innerHTML = `
                    <tr class="border-b border-gray-800 text-gray-500 uppercase tracking-wider text-[9px] font-bold font-mono">
                        ${showCols.map(c => `<th class="pb-1.5 pr-3">${c}</th>`).join('')}
                    </tr>
                `;

                // Populate tbody
                if (!data.rows || data.rows.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="${showCols.length}" class="py-4 text-center text-gray-600 font-mono">Файл пуст</td></tr>`;
                } else {
                    tbody.innerHTML = data.rows.map(r => {
                        return `
                            <tr class="hover:bg-[#1E1F24]/40 font-mono text-[9px] text-gray-400">
                                ${showCols.map(c => {
                                    let v = r[c];
                                    if (typeof v === 'number') {
                                        // Align floats for readability
                                        v = v.toFixed(c.toLowerCase().includes('time') || c.toLowerCase().includes('vol') ? 0 : 5);
                                    }
                                    if (v === null || v === undefined) v = 'NaN';
                                    return `<td class="py-1.5 pr-3 font-mono">${v}</td>`;
                                }).join('')}
                            </tr>
                        `;
                    }).join('');
                }
                
                // Show step 2 panel if clicked from explorer
                switchLiteDataStep(2);

            } catch (err) {
                tbody.innerHTML = `<tr><td colspan="4" class="py-4 text-center text-rose-400 font-mono"><i class="fa-solid fa-exclamation-triangle"></i> Ошибка: ${err.message}</td></tr>`;
            }
        }

        function clearLiteDataConsole() {
