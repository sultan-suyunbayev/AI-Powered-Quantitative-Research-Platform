        let quantlabLastResults = null;

        async function runQuantLabEvaluation(capital) {
            document.getElementById('quantlab-results-status').innerText = "Оценка...";
            document.getElementById('quantlab-chart-spinner').classList.remove('hidden');
            document.getElementById('quantlab-eval-chart-placeholder').classList.add('hidden');
            
            try {
                const evalRes = await fetch(API_BASE + '/api/run_job', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        job: 'run_eval',
                        params: {
                            capital_base: capital,
                            rf_annual: 0.0
                        }
                    })
                });
                
                if (evalRes.ok) {
                    setTimeout(async () => {
                        try {
                            const resResults = await fetch(API_BASE + '/api/eval/results');
                            if (resResults.ok) {
                                const resData = await resResults.json();
                                quantlabLastResults = resData;
                                
                                const eq = resData.equity || {};
                                const tr = resData.trades || {};
                                
                                let grossProfit = parseFloat(tr.gross_profit) || 0.0;
                                let grossLoss = parseFloat(tr.gross_loss) || 0.0;
                                let profitFactor = "—";
                                if (grossLoss > 0) {
                                    profitFactor = (grossProfit / grossLoss).toFixed(2);
                                } else if (grossProfit > 0) {
                                    profitFactor = "∞";
                                }
                                
                                const fmtPct = (v) => {
                                    if (v === undefined || v === null || isNaN(v)) return '—';
                                    return (v * 100).toFixed(2) + '%';
                                };
                                const fmtVal = (v, d = 2) => {
                                    if (v === undefined || v === null || isNaN(v)) return '—';
                                    return v.toFixed(d);
                                };
                                
                                document.getElementById('quantlab-res-sharpe').innerText = fmtVal(eq.sharpe_ratio);
                                document.getElementById('quantlab-res-maxdd').innerText = fmtPct(eq.max_drawdown);
                                document.getElementById('quantlab-res-return').innerText = fmtPct(eq.total_return);
                                document.getElementById('quantlab-res-winrate').innerText = fmtPct(tr.win_rate);
                                document.getElementById('quantlab-res-trades').innerText = tr.total_trades !== undefined ? tr.total_trades : '—';
                                document.getElementById('quantlab-res-pf').innerText = profitFactor;
                                
                                const chart = document.getElementById('quantlab-eval-chart');
                                chart.src = API_BASE + '/api/image?path=logs/equity.png&t=' + Date.now();
                                chart.onload = () => {
                                    document.getElementById('quantlab-chart-spinner').classList.add('hidden');
                                    chart.classList.remove('opacity-0');
                                    chart.classList.add('opacity-100');
                                };
                                
                                document.getElementById('quantlab-results-status').innerText = "Готово";
                                document.getElementById('btn-save-to-registry').classList.remove('hidden');
                                showActionToast("Бэктест и оценка успешно завершены!");
                                 loadDeepAttributionData();
                            } else {
                                document.getElementById('quantlab-results-status').innerText = "Ошибка оценки";
                                document.getElementById('quantlab-chart-spinner').classList.add('hidden');
                            }
                        } catch (e) {
                            console.error("Error loading evaluation results:", e);
                            document.getElementById('quantlab-results-status').innerText = "Ошибка";
                            document.getElementById('quantlab-chart-spinner').classList.add('hidden');
                        }
                    }, 2000);
                } else {
                    document.getElementById('quantlab-results-status').innerText = "Ошибка запуска оценки";
                    document.getElementById('quantlab-chart-spinner').classList.add('hidden');
                }
            } catch (err) {
                console.error("Error running evaluation:", err);
                document.getElementById('quantlab-results-status').innerText = "Ошибка";
                document.getElementById('quantlab-chart-spinner').classList.add('hidden');
            }
            
            // Restore backtest buttons
            const btnStart = document.getElementById('btn-quantlab-backtest-start');
            const btnStop = document.getElementById('btn-quantlab-backtest-stop');
            btnStart.removeAttribute('disabled');
            btnStart.classList.remove('opacity-50', 'cursor-not-allowed');
            btnStop.setAttribute('disabled', 'true');
            btnStop.classList.add('opacity-50', 'cursor-not-allowed');
        }

        // STRATEGY REGISTRY LOCALSTORAGE CONTROLLERS
        function getStrategyRegistry() {
            try {
                const data = localStorage.getItem('quantlab_strategy_registry');
                return data ? JSON.parse(data) : [];
            } catch (e) {
                console.error("Error loading registry:", e);
                return [];
            }
        }

        function saveStrategyRegistry(registry) {
            localStorage.setItem('quantlab_strategy_registry', JSON.stringify(registry));
        }

        function saveToStrategyRegistry() {
            if (!quantlabLastResults) {
                showActionToast("Нет результатов для сохранения!", "error");
                return;
            }
            
            const name = prompt("Введите название/версию стратегии:", `PPO_${activeAsset.toUpperCase()}_v${(getStrategyRegistry().length + 1).toFixed(1)}`);
            if (!name) return;
            
            const registry = getStrategyRegistry();
            const eq = quantlabLastResults.equity || {};
            const tr = quantlabLastResults.trades || {};
            
            let grossProfit = parseFloat(tr.gross_profit) || 0.0;
            let grossLoss = parseFloat(tr.gross_loss) || 0.0;
            let profitFactor = "—";
            if (grossLoss > 0) {
                profitFactor = (grossProfit / grossLoss).toFixed(2);
            }
            
            const newStrategy = {
                id: 'strat_' + Date.now(),
                name: name,
                date: new Date().toLocaleDateString(),
                asset: activeAsset,
                sharpe: eq.sharpe_ratio,
                maxdd: eq.max_drawdown,
                return: eq.total_return,
                pf: profitFactor,
                trades: tr.total_trades,
                winrate: tr.win_rate,
                model_path: document.getElementById('quantlab-backtest-model-path').value,
                strategy_path: document.getElementById('quantlab-backtest-strategy').value
            };
            
            registry.push(newStrategy);
            saveStrategyRegistry(registry);
            showActionToast("Стратегия добавлена в Реестр.");
            loadStrategyRegistry();
        }

        function loadStrategyRegistry() {
            const container = document.getElementById('registry-table-body');
            if (!container) return;
            
            const registry = getStrategyRegistry();
            if (registry.length === 0) {
                container.innerHTML = `
                    <tr>
                        <td colspan="10" class="text-center py-6 text-gray-600 font-mono">
                            Реестр стратегий пуст. Запустите бэктест и сохраните результаты.
                        </td>
                    </tr>`;
                return;
            }
            
            container.innerHTML = registry.map(strat => {
                const sharpeVal = strat.sharpe !== undefined ? strat.sharpe.toFixed(2) : '—';
                const maxddVal = strat.maxdd !== undefined ? (strat.maxdd * 100).toFixed(2) + '%' : '—';
                const returnVal = strat.return !== undefined ? (strat.return * 100).toFixed(2) + '%' : '—';
                const pfVal = strat.pf || '—';
                
                return `
                    <tr class="hover:bg-[#1A1A22]/40 transition-colors border-b border-[#2B2B36]/10">
                        <td class="px-4 py-2 text-center">
                            <input type="checkbox" name="registry-compare-select" value="${strat.id}" class="w-3.5 h-3.5 rounded bg-[#131316] border border-[#2B2B36] text-blue-500 focus:ring-blue-500/50 cursor-pointer">
                        </td>
                        <td class="px-4 py-2 font-semibold text-white">${strat.name}</td>
                        <td class="px-4 py-2 uppercase text-gray-400">${strat.asset}</td>
                        <td class="px-4 py-2 text-right text-white">${sharpeVal}</td>
                        <td class="px-4 py-2 text-right text-rose-400">${maxddVal}</td>
                        <td class="px-4 py-2 text-right text-emerald-400">${returnVal}</td>
                        <td class="px-4 py-2 text-right text-white">${pfVal}</td>
                        <td class="px-4 py-2 text-right text-gray-400">${strat.trades || '—'}</td>
                        <td class="px-4 py-2 text-center text-gray-500 font-mono select-none" id="status-badge-${strat.id}">Не активна</td>
                        <td class="px-4 py-2 text-center space-x-1.5 flex justify-center items-center">
                            <button onclick="activateStrategy('${strat.id}')" class="px-2 py-0.5 bg-emerald-600/10 hover:bg-emerald-600/25 border border-emerald-500/20 hover:border-emerald-500/50 text-emerald-400 rounded text-[9px] font-semibold transition-all font-mono">Активировать</button>
                            <button onclick="deleteFromStrategyRegistry('${strat.id}')" class="px-1.5 py-0.5 bg-red-600/10 hover:bg-red-600/25 border border-red-500/20 text-red-400 rounded text-[9px] font-semibold transition-all"><i class="fa-solid fa-trash"></i></button>
                        </td>
                    </tr>`;
            }).join('');
        }

        function deleteFromStrategyRegistry(id) {
            let registry = getStrategyRegistry();
            registry = registry.filter(s => s.id !== id);
            saveStrategyRegistry(registry);
            showActionToast("Стратегия удалена из Реестра.");
            loadStrategyRegistry();
        }

        function clearStrategyRegistry() {
            if (!confirm("Вы уверены, что хотите очистить весь Реестр стратегий?")) return;
            localStorage.removeItem('quantlab_strategy_registry');
            showActionToast("Реестр полностью очищен.");
            loadStrategyRegistry();
        }

        async function activateStrategy(id) {
            const registry = getStrategyRegistry();
            const strat = registry.find(s => s.id === id);
            if (!strat) return;
            
            try {
                const res = await fetch(API_BASE + '/api/run_job', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        job: '/start',
                        params: {
                            model_path: strat.model_path,
                            is_custom_strategy: true,
                            strategy_params: {
                                strategy: strat.strategy_path
                            }
                        }
                    })
                });
                
                registry.forEach(s => {
                    const badge = document.getElementById(`status-badge-${s.id}`);
                    if (badge) {
                        if (s.id === id) {
                            badge.innerHTML = `<span class="bg-emerald-500/10 text-emerald-400 text-[8px] px-1.5 py-0.5 rounded border border-emerald-500/20">АКТИВНА</span>`;
                        } else {
                            badge.innerText = "Не активна";
                        }
                    }
                });
                
                showActionToast(`Стратегия ${strat.name} успешно активирована для живого конвейера.`);
            } catch (e) {
                console.error("Error activating strategy:", e);
                showActionToast("Не удалось подключить стратегию на сервере.", "error");
            }
        }

