                        banner.className = "p-3 rounded-2xl border border-emerald-500/20 bg-emerald-500/5 text-emerald-400 text-[11px] font-mono leading-relaxed";
                        banner.innerText = `[SUCCESS] ${data.message}`;
                        showActionToast("Стратегия успешно скомпилирована и сохранена!");
                    } else if (data.status === "warning") {
                        banner.className = "p-3 rounded-2xl border border-yellow-500/20 bg-yellow-500/5 text-yellow-400 text-[11px] font-mono leading-relaxed";
                        banner.innerText = `[WARNING] ${data.message}`;
