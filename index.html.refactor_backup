        function initMonacoCoder(initialValue = "") {
            const editorDiv = document.getElementById('strategy-monaco-editor');
            const fallbackTextArea = document.getElementById('strategy-editor-fallback');
            
            if (monacoLoaded && coderMonacoEditor) {
                coderMonacoEditor.setValue(initialValue);
                return;
            }
            
            if (typeof require === 'undefined') {
                const script = document.createElement('script');
                script.src = "https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.39.0/min/vs/loader.min.js";
                script.onload = () => {
                    require.config({ paths: { vs: 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.39.0/min/vs' } });
                    require(['vs/editor/editor.main'], function () {
                        coderMonacoEditor = monaco.editor.create(editorDiv, {
                            value: initialValue,
                            language: 'python',
                            theme: 'vs-dark',
                            automaticLayout: true,
                            minimap: { enabled: true },
                            fontSize: 12,
                            lineHeight: 18,
                            fontFamily: "'JetBrains Mono', 'Fira Code', monospace"
                        });
                        monacoLoaded = true;
                        fallbackTextArea.classList.add('hidden');
                        editorDiv.classList.remove('hidden');
                    });
                };
                script.onerror = () => {
                    console.warn("Monaco Editor failed to load from CDN. Falling back to standard textarea.");
                    fallbackTextArea.value = initialValue;
                    fallbackTextArea.classList.remove('hidden');
                    editorDiv.classList.add('hidden');
                };
                document.head.appendChild(script);
            } else {
                try {
                    require(['vs/editor/editor.main'], function () {
                        coderMonacoEditor = monaco.editor.create(editorDiv, {
                            value: initialValue,
                            language: 'python',
                            theme: 'vs-dark',
                            automaticLayout: true,
                            minimap: { enabled: true },
                            fontSize: 12,
                            lineHeight: 18,
                            fontFamily: "'JetBrains Mono', 'Fira Code', monospace"
                        });
                        monacoLoaded = true;
                        fallbackTextArea.classList.add('hidden');
                        editorDiv.classList.remove('hidden');
                    });
                } catch(e) {
                    fallbackTextArea.value = initialValue;
                    fallbackTextArea.classList.remove('hidden');
                    editorDiv.classList.add('hidden');
                }
            }
        }

