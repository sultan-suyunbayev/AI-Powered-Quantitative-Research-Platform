                    const err = await res.json();
                    logPre.innerText = `Ошибка запуска: ${err.detail || 'Неизвестная ошибка'}`;
                    resetCoderBacktestUI();
                }
            } catch (err) {
                logPre.innerText = `Сетевая ошибка: ${err.message}`;
                resetCoderBacktestUI();
