        function calculatePearsonCorrelation() {
            if (!quantlabLoadedPreview || !quantlabLoadedPreview.rows || quantlabLoadedPreview.rows.length === 0) {
                return;
            }
            
            const checklist = document.getElementById('quantlab-features-checklist');
            const checkedBoxes = checklist.querySelectorAll('input[type="checkbox"]:checked');
            const selectedCols = Array.from(checkedBoxes).map(cb => cb.value);
            
            const statusEl = document.getElementById('quantlab-corr-status');
            const headerEl = document.getElementById('quantlab-corr-header');
            const bodyEl = document.getElementById('quantlab-corr-body');
            
            if (selectedCols.length < 2) {
                statusEl.innerText = "Ошибка: выберите не менее 2 признаков";
                bodyEl.innerHTML = `<tr><td colspan="100" class="p-3 text-center text-gray-500">Пожалуйста, выберите хотя бы 2 признака.</td></tr>`;
                return;
            }
            
            statusEl.innerText = "Расчет...";
            
            const matrix = {};
            const rows = quantlabLoadedPreview.rows;
            
            selectedCols.forEach(c => matrix[c] = {});
            
            for (let i = 0; i < selectedCols.length; i++) {
                for (let j = i; j < selectedCols.length; j++) {
                    const c1 = selectedCols[i];
                    const c2 = selectedCols[j];
                    
                    const v1 = rows.map(r => Number(r[c1])).filter(v => !isNaN(v));
                    const v2 = rows.map(r => Number(r[c2])).filter(v => !isNaN(v));
                    
                    const minLen = Math.min(v1.length, v2.length);
                    const aligned1 = v1.slice(0, minLen);
                    const aligned2 = v2.slice(0, minLen);
                    
                    let rVal = 0;
                    if (aligned1.length > 1) {
                        let n = aligned1.length;
                        let m1 = aligned1.reduce((a,b)=>a+b, 0) / n;
                        let m2 = aligned2.reduce((a,b)=>a+b, 0) / n;
                        let num = 0, d1 = 0, d2 = 0;
                        for (let k = 0; k < n; k++) {
                            let diff1 = aligned1[k] - m1;
                            let diff2 = aligned2[k] - m2;
                            num += diff1 * diff2;
                            d1 += diff1 * diff1;
                            d2 += diff2 * diff2;
                        }
                        rVal = d1 === 0 || d2 === 0 ? 0 : num / Math.sqrt(d1 * d2);
                    } else {
                        rVal = c1 === c2 ? 1.0 : 0.0;
                    }
                    
                    matrix[c1][c2] = rVal;
                    matrix[c2][c1] = rVal;
                }
            }
            
            const displayCols = selectedCols.slice(0, 8);
            
            headerEl.innerHTML = `<th class="p-2 border-b border-[#2B2B36]">Признак</th>` + 
                displayCols.map(c => `<th class="p-2 border-b border-[#2B2B36] text-[8px] truncate max-w-[65px]" title="${c}">${c}</th>`).join('');
                
            bodyEl.innerHTML = displayCols.map(c1 => {
                return `
                    <tr class="border-b border-[#2B2B36]/10 hover:bg-[#1A1A22]/20">
                        <td class="p-2 font-bold text-gray-400 text-[9px] truncate max-w-[80px]" title="${c1}">${c1}</td>
                        ${displayCols.map(c2 => {
                            const val = matrix[c1][c2];
                            const valText = val.toFixed(2);
                            
                            let redColor = 0, greenColor = 0, blueColor = 0;
                            if (val >= 0) {
                                redColor = 239; greenColor = 68; blueColor = 68;
                            } else {
                                redColor = 59; greenColor = 130; blueColor = 246;
                            }
                            const alpha = Math.abs(val).toFixed(2);
                            const bgStyle = `background-color: rgba(${redColor}, ${greenColor}, ${blueColor}, ${alpha}); color: ${Math.abs(val) > 0.4 ? '#ffffff' : 'rgba(255,255,255,0.7)'};`;
                            
                            return `<td class="p-2 text-center text-[9px]" style="${bgStyle}">${valText}</td>`;
                        }).join('')}
                    </tr>
                `;
            }).join('');
            
            statusEl.innerText = "Готово" + (selectedCols.length > 8 ? " (первые 8)" : "");
            
            const xCol = document.getElementById('quantlab-scatter-x').value;
            const yCol = document.getElementById('quantlab-scatter-y').value;
            
            if (xCol && yCol) {
                const scatterPoints = rows.map(r => ({
                    x: Number(r[xCol]),
                    y: Number(r[yCol])
                })).filter(pt => !isNaN(pt.x) && !isNaN(pt.y));
                
                const placeholder = document.getElementById('quantlab-scatter-placeholder');
                if (placeholder) placeholder.classList.add('hidden');
                
                if (quantlabScatterChart) {
                    quantlabScatterChart.destroy();
                }
                const ctx = document.getElementById('quantlab-scatter-canvas').getContext('2d');
                quantlabScatterChart = new Chart(ctx, {
                    type: 'scatter',
                    data: {
                        datasets: [{
                            label: `${xCol} vs ${yCol}`,
                            data: scatterPoints.slice(0, 300),
                            backgroundColor: 'rgba(236, 72, 153, 0.65)',
                            borderColor: 'rgb(236, 72, 153)',
                            borderWidth: 1,
                            pointRadius: 2.5
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: (ctx) => `${xCol}: ${ctx.raw.x.toFixed(4)}, ${yCol}: ${ctx.raw.y.toFixed(4)}`
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { color: 'rgba(43, 43, 54, 0.15)' },
                                ticks: { color: '#9CA3AF', font: { family: 'JetBrains Mono', size: 8 } }
                            },
                            y: {
                                grid: { color: 'rgba(43, 43, 54, 0.15)' },
                                ticks: { color: '#9CA3AF', font: { family: 'JetBrains Mono', size: 8 } }
                            }
                        }
                    }
                });
            }
        }

