        async function submitCopilotMessage() {
            const inputEl = document.getElementById('copilot-input');
            const messageText = inputEl.value.trim();
            if (!messageText) return;

            // Clear input
            inputEl.value = '';

            // Render user bubble
            appendChatBubble('user', messageText);

            // Send to backend
            try {
                const res = await fetch(API_BASE + '/api/copilot', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({message: messageText})
                });
                if (res.ok) {
                    const data = await res.json();
                    appendChatBubble('assistant', data.response);
                    // Check if command triggered a view switch
                    if (data.switch_to) {
                        switchModule(data.switch_to);
                    }
                } else {
                    appendChatBubble('assistant', `Ошибка связи с ассистентом: ${res.statusText}`);
                }
            } catch (err) {
                appendChatBubble('assistant', `Ошибка сети: ${err.message}`);
            }
        }

