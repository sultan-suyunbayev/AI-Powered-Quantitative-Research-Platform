        async function loadThresholdScan(scanPath = null) {
            if (!scanPath) {
                scanPath = document.getElementById('quantlab-backtest-data-path').value.replace(/\.(parquet|csv|pq|txt)/i, '_thrscan.csv');
            }
            
            try {
                const res = await fetch(API_BASE + `/api/data/preview?path=${scanPath}&n=200`);
                if (!res.ok) {
                    throw new Error(`Файл результатов не найден.`);
                }
                
                const data = await res.json();
                if (!data || !data.rows || data.rows.length === 0) {
                    throw new Error("Таблица результатов подбора пуста.");
                }
                
                tunerScanResults = data.rows;
                
                let bestSharpe = { val: -Infinity, thr: 0.75 };
                let bestF1 = { val: -Infinity, thr: 0.65 };
                let bestPrecision = { val: -Infinity, thr: 0.80 };
                
                tunerScanResults.forEach(r => {
                    const thr = parseFloat(r.threshold);
                    const sharpe = parseFloat(r.sharpe) || 0.0;
                    const f1 = parseFloat(r.f1) || 0.0;
                    const precision = parseFloat(r.precision) || 0.0;
                    
                    if (sharpe > bestSharpe.val) {
                        bestSharpe = { val: sharpe, thr: thr };
                    }
                    if (f1 > bestF1.val) {
                        bestF1 = { val: f1, thr: thr };
                    }
                    if (precision > bestPrecision.val) {
                        bestPrecision = { val: precision, thr: thr };
                    }
                });
                
                document.getElementById('quantlab-tuner-best-sharpe-val').innerText = `${bestSharpe.thr.toFixed(2)} (Sh: ${bestSharpe.val.toFixed(2)})`;
                document.getElementById('quantlab-tuner-best-f1-val').innerText = `${bestF1.thr.toFixed(2)} (F1: ${bestF1.val.toFixed(2)})`;
                document.getElementById('quantlab-tuner-best-precision-val').innerText = `${bestPrecision.thr.toFixed(2)} (Pr: ${(bestPrecision.val * 100).toFixed(0)}%)`;
                
                const btnSharpe = document.getElementById('btn-apply-sharpe');
                btnSharpe.removeAttribute('disabled');
                btnSharpe.classList.remove('opacity-50', 'cursor-not-allowed');
                btnSharpe.setAttribute('data-thr', bestSharpe.thr);
                
                const btnF1 = document.getElementById('btn-apply-f1');
                btnF1.removeAttribute('disabled');
                btnF1.classList.remove('opacity-50', 'cursor-not-allowed');
                btnF1.setAttribute('data-thr', bestF1.thr);
                
                const btnPrec = document.getElementById('btn-apply-precision');
                btnPrec.removeAttribute('disabled');
                btnPrec.classList.remove('opacity-50', 'cursor-not-allowed');
                btnPrec.setAttribute('data-thr', bestPrecision.thr);
                
                drawTunerChart();
                showActionToast("Импортированы рекомендованные пороги!");
            } catch (err) {
                document.getElementById('quantlab-tuner-placeholder').innerText = err.message;
            }
        }

