                        if (parityCard) parityCard.className = "bg-[#1A1A22] border border-rose-500/20 rounded-xl p-3 text-center space-y-0.5 shadow-sm animate-pulse";
                    } else {
                        if (parityStatus) parityStatus.innerText = "—";
                        if (parityCard) parityCard.className = "bg-[#1A1A22] border border-[#2B2B36]/60 rounded-xl p-3 text-center space-y-0.5";
                    }
                }
                
                // Parse drift PSI report
                const driftReportRes = await fetch(API_BASE + `/api/json/get_file?path=models/drift_report.json`);
                if (driftReportRes.ok) {
                    const report = await driftReportRes.json();
                    const psiVal = report.avg_psi;
                    
                    if (driftStatus) {
                        let colorClass = "text-emerald-400";
                        let borderClass = "border-emerald-500/20";
                        
                        if (report.status === 'warning') {
                            colorClass = "text-amber-400";
                            borderClass = "border-amber-500/20";
                        } else if (report.status === 'drift') {
                            colorClass = "text-rose-400";
                            borderClass = "border-rose-500/25 animate-pulse";
                        }
                        
                        driftStatus.innerHTML = `<span class="${colorClass} font-bold">${psiVal.toFixed(3)}</span>`;
                        if (driftCard) driftCard.className = `bg-[#1A1A22] border ${borderClass} rounded-xl p-3 text-center space-y-0.5 shadow-sm`;
                    }
                    
                    // Update progress bar
                    if (driftBarContainer && driftBarLabel && driftBar) {
                        driftBarContainer.classList.remove('hidden');
                        driftBarLabel.innerText = `PSI = ${psiVal.toFixed(3)} (${report.status_label.split(' ')[0]})`;
                        
                        let pct = Math.min(100, (psiVal / 0.3) * 100);
                        driftBar.style.width = pct + '%';
                        
                        if (report.status === 'stable') {
                            driftBar.className = "h-full bg-emerald-500 transition-all duration-300";
                        } else if (report.status === 'warning') {
                            driftBar.className = "h-full bg-amber-500 transition-all duration-300";
                        } else {
                            driftBar.className = "h-full bg-rose-500 transition-all duration-300";
                        }
                    }
                }
                
                // Parse features PSI CSV preview
                const psiCsvRes = await fetch(API_BASE + `/api/data/preview?path=data/features_psi.csv&n=15`);
                if (psiCsvRes.ok && driftTbody) {
                    const data = await psiCsvRes.json();
                    if (data.rows && data.rows.length > 0) {
                        driftTbody.innerHTML = '';
                        data.rows.forEach(r => {
                            const tr = document.createElement('tr');
                            tr.className = "hover:bg-[#1A1A22]/30";
                            
                            const valPsi = parseFloat(r.psi || 0);
                            let statusText = `<span class="text-emerald-500 font-bold">OK</span>`;
                            if (valPsi >= 0.25) {
                                statusText = `<span class="text-rose-500 font-bold">DRIFT</span>`;
                            } else if (valPsi >= 0.1) {
                                statusText = `<span class="text-amber-500 font-bold">WARN</span>`;
                            }
                            
                            tr.innerHTML = `
                                <td class="p-2 py-1.5 text-gray-300 font-sans truncate max-w-[120px]">${r.feature}</td>
                                <td class="p-2 py-1.5 text-right font-mono">${valPsi.toFixed(4)}</td>
                                <td class="p-2 py-1.5 text-right">${statusText}</td>
                            `;
                            driftTbody.appendChild(tr);
                        });
                    }
                }
            } catch (err) {
                console.error("Error loading audit results:", err);
            }
        }

