        function populateAdapterSelect(assetClass, selectVal) {
            const selectEl = document.getElementById('adapter-select');
            if (selectEl) {
                selectEl.innerHTML = '';
                const list = adaptersByAsset[assetClass] || [];
                list.forEach(ad => {
                    const opt = document.createElement('option');
                    opt.value = ad;
                    opt.innerText = ad.toUpperCase();
                    if (ad === selectVal) {
                        opt.selected = true;
                    }
                    selectEl.appendChild(opt);
                });
            }
        }

