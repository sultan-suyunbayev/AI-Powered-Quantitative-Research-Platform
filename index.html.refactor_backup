                                    showActionToast("Оптимизация порогов завершена!");
                                    let scanPath = dataPath.replace(/\.(parquet|csv|pq|txt)/i, '_thrscan.csv');
                                    loadThresholdScan(scanPath);
                                }
                            }
                        } catch (err) {
                            clearInterval(tunerInterval);
                            console.error("Error polling tuner status:", err);
                        }
                    }, 1000);
                } else {
                    const errText = await res.text();
                    chartPlaceholder.innerText = `Ошибка запуска: ${errText}`;
                }
            } catch (err) {
                chartPlaceholder.innerText = `Сетевая ошибка: ${err.message}`;
