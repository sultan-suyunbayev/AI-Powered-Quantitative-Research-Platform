        // Job Executer Wrapper
        async function runLiteAgentsJob(jobName, params, onComplete) {
            const consolePre = document.getElementById('liteagents-console-output');
            const indicator = document.getElementById('liteagents-console-indicator');
            
            if (consolePre) consolePre.innerText = "Инициализация задачи...\n";
            if (indicator) indicator.classList.remove('hidden');
            
            if (agentsConsoleInterval) {
                clearInterval(agentsConsoleInterval);
                agentsConsoleInterval = null;
            }
            
            try {
                const res = await fetch(API_BASE + '/api/run_job', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        job: jobName,
                        params: params || {}
                    })
                });
                
                if (!res.ok) {
                    const err = await res.json();
                    if (consolePre) consolePre.innerText += `Ошибка запуска: ${err.detail || 'Неизвестная ошибка'}\n`;
                    if (indicator) indicator.classList.add('hidden');
                    return;
                }
                
                const data = await res.json();
                const logFileName = jobName + ".log";
                if (consolePre) consolePre.innerText += `Задача запущена (PID: ${data.pid}). Получение логов...\n\n`;
                
                runningAgentJobId = jobName;
                
                agentsConsoleInterval = setInterval(async () => {
                    const statusRes = await fetch(API_BASE + `/api/job/status?job=${jobName}`);
                    let isRunning = true;
                    if (statusRes.ok) {
                        const statusData = await statusRes.json();
                        isRunning = statusData.running;
                    }
                    
                    const logRes = await fetch(API_BASE + `/api/logs?name=${logFileName}`);
                    if (logRes.ok) {
                        const logText = await logRes.text();
                        if (consolePre) {
                            consolePre.innerText = logText;
                            consolePre.scrollTop = consolePre.scrollHeight;
                        }
                    }
                    
                    if (!isRunning) {
                        clearInterval(agentsConsoleInterval);
                        agentsConsoleInterval = null;
                        runningAgentJobId = null;
                        if (indicator) indicator.classList.add('hidden');
                        if (consolePre) {
                            consolePre.innerText += "\n--- Задача завершена ---";
                            consolePre.scrollTop = consolePre.scrollHeight;
                        }
                        if (onComplete) onComplete();
                    }
                }, 1000);
                
            } catch (err) {
                if (consolePre) consolePre.innerText += `Сетевая ошибка: ${err.message}\n`;
                if (indicator) indicator.classList.add('hidden');
            }
        }

