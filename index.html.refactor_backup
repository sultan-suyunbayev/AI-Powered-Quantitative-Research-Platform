        function streamLiteDataLogs(logName) {
            const el = document.getElementById('litedata-console-output');
            if (!el) return;

            if (liteDataLogInterval) {
                clearInterval(liteDataLogInterval);
            }

            let attempt = 0;
            liteDataLogInterval = setInterval(async () => {
                try {
                    const res = await fetch(API_BASE + `/api/logs?name=${logName}`);
                    if (res.ok) {
                        const logs = await res.text();
                        if (logs.trim()) {
                            el.innerText = logs;
                            el.scrollTop = el.scrollHeight; // Scroll to bottom
                        } else {
                            el.innerText = `[${new Date().toLocaleTimeString()}] Ожидание записей в ${logName}...`;
                        }
                    } else {
                        attempt++;
                        if (attempt > 3) {
                            el.innerText = `[Система] Лог ${logName} еще не создан. Ожидание запуска фонового процесса...`;
                        }
                    }
                } catch (e) {
                    el.innerText = `Ошибка стриминга лога: ${e.message}`;
                }
            }, 2000);
        }

        async function triggerLiteDataJob(jobName, params, logName) {
            clearLiteDataConsole();
            const el = document.getElementById('litedata-console-output');
            if (el) el.innerText = `Отправка команды ${jobName} на сервер...`;

            showActionToast(`Запуск задачи: ${jobName}...`);

            try {
                const res = await fetch(API_BASE + '/api/run_job', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        job: jobName,
                        params: params
                    })
                });

                if (!res.ok) {
                    const err = await res.text();
                    if (el) el.innerText = `[Error] Сервер отклонил задачу: ${err}`;
                    showActionToast(`❌ Ошибка запуска: ${err}`);
                    return;
                }

                const data = await res.json();
                if (el) el.innerText = `[Запущено] Задача запущена в фоне, PID = ${data.pid || 'N/A'}. Начало стриминга логов...\n`;
                
                // Stream logs
                streamLiteDataLogs(logName);

                // Setup listener for task completion
                let checkStatusInterval = setInterval(async () => {
                    try {
                        const statusRes = await fetch(API_BASE + `/api/job/status?job=${jobName.replace('/', '')}`);
                        if (statusRes.ok) {
                            const status = await statusRes.json();
                            if (!status.running) {
                                clearInterval(checkStatusInterval);
                                if (liteDataLogInterval) {
                                    clearInterval(liteDataLogInterval);
                                    liteDataLogInterval = null;
                                }
                                showActionToast(`✅ Задача ${jobName} успешно завершена!`);
                                // Refresh files Explorer
                                await checkDataFiles();
                            }
                        }
                    } catch (e) {}
                }, 4000);

            } catch (err) {
                if (el) el.innerText = `[Сетевая ошибка] ${err.message}`;
                showActionToast(`❌ Сетевой сбой: ${err.message}`);
            }
        }

