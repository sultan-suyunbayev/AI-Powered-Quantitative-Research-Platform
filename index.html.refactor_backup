        function drawAttributionCharts(rows) {
            let peak = -Infinity;
            const drawdownData = [];
            const labels = [];
            
            const equities = rows.map(r => parseFloat(r.equity) || 50000.0);
            const barReturns = rows.map(r => parseFloat(r.bar_return) || 0.0);
            const refPrices = rows.map(r => parseFloat(r.ref_price) || 0.0);
            const timestamps = rows.map((r, idx) => {
                const t = parseInt(r.ts_ms);
                return isNaN(t) ? new Date() : new Date(t * 1000);
            });
            
            equities.forEach((eq, idx) => {
                if (eq > peak) peak = eq;
                const dd = peak === 0 ? 0 : (eq - peak) / peak * 100;
                drawdownData.push(dd);
                labels.push(idx % 100 === 0 && timestamps[idx] ? timestamps[idx].toLocaleDateString() : '');
            });
            
            const drawdownPlaceholder = document.getElementById('quantlab-drawdown-placeholder');
            if (drawdownPlaceholder) drawdownPlaceholder.classList.add('hidden');
            
            if (quantlabDrawdownChart) {
                quantlabDrawdownChart.destroy();
            }
            const ctxDD = document.getElementById('quantlab-drawdown-chart').getContext('2d');
            quantlabDrawdownChart = new Chart(ctxDD, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Drawdown %',
                        data: drawdownData,
                        borderColor: 'rgb(244, 63, 94)',
                        backgroundColor: 'rgba(244, 63, 94, 0.08)',
                        borderWidth: 1.2,
                        fill: true,
                        pointRadius: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: {
                            grid: { color: 'rgba(43, 43, 54, 0.1)' },
                            ticks: { color: '#9CA3AF', font: { family: 'JetBrains Mono', size: 7 } }
                        },
                        y: {
                            grid: { color: 'rgba(43, 43, 54, 0.15)' },
                            ticks: { color: '#9CA3AF', font: { family: 'JetBrains Mono', size: 7.5 } }
                        }
                    }
                }
            });
            
            // Monte Carlo Bootstrap Path generation
            const nSims = 50;
            const steps = 80; 
            const stepSize = Math.max(1, Math.floor(barReturns.length / steps));
            
            const simulatedPaths = [];
            const initialCapital = equities[0] || 50000.0;
            
            for (let s = 0; s < nSims; s++) {
                const path = [initialCapital];
                let curCap = initialCapital;
                
                for (let st = 1; st <= steps; st++) {
                    for (let b = 0; b < stepSize; b++) {
                        const randRet = barReturns[Math.floor(Math.random() * barReturns.length)] || 0.0;
                        curCap = curCap * (1.0 + randRet);
                    }
                    path.push(curCap);
                }
                simulatedPaths.push(path);
            }
            
            const p10 = [];
            const p50 = [];
            const p90 = [];
            
            for (let st = 0; st <= steps; st++) {
                const stepCaps = simulatedPaths.map(p => p[st]).sort((a, b) => a - b);
                p10.push(stepCaps[Math.floor(nSims * 0.1)]);
                p50.push(stepCaps[Math.floor(nSims * 0.5)]);
                p90.push(stepCaps[Math.floor(nSims * 0.9)]);
            }
            
            const mcPlaceholder = document.getElementById('quantlab-montecarlo-placeholder');
            if (mcPlaceholder) mcPlaceholder.classList.add('hidden');
            
            if (quantlabMonteCarloChart) {
                quantlabMonteCarloChart.destroy();
            }
            
            const ctxMC = document.getElementById('quantlab-montecarlo-chart').getContext('2d');
            const mcDatasets = [];
            
            simulatedPaths.forEach((path, idx) => {
                mcDatasets.push({
                    label: `Sim ${idx}`,
                    data: path,
                    borderColor: 'rgba(99, 102, 241, 0.05)',
                    borderWidth: 1,
                    pointRadius: 0,
                    fill: false
                });
            });
            
            mcDatasets.push(
                {
                    label: '10th Percentile',
                    data: p10,
                    borderColor: 'rgba(244, 63, 94, 0.85)',
                    borderWidth: 1.5,
                    pointRadius: 0,
                    fill: false
                },
                {
                    label: 'Median',
                    data: p50,
                    borderColor: 'rgba(59, 130, 246, 0.85)',
                    borderWidth: 1.5,
                    pointRadius: 0,
                    fill: false
                },
                {
                    label: '90th Percentile',
                    data: p90,
                    borderColor: 'rgba(16, 185, 129, 0.85)',
                    borderWidth: 1.5,
                    pointRadius: 0,
                    fill: false
                }
            );
            
            quantlabMonteCarloChart = new Chart(ctxMC, {
                type: 'line',
                data: {
                    labels: Array.from({ length: steps + 1 }, (_, i) => ''),
                    datasets: mcDatasets
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { display: false },
                        y: {
                            grid: { color: 'rgba(43, 43, 54, 0.15)' },
                            ticks: { color: '#9CA3AF', font: { family: 'JetBrains Mono', size: 7.5 } }
                        }
                    }
                }
            });
            
            // Market regime stats
            const smaLen = 50;
            const trendRegimes = [];
            let sum = 0;
            
            for (let i = 0; i < refPrices.length; i++) {
                sum += refPrices[i];
                if (i >= smaLen) {
                    sum -= refPrices[i - smaLen];
                    const sma = sum / smaLen;
                    trendRegimes.push(refPrices[i] > sma ? 'Bull' : 'Bear');
                } else {
                    trendRegimes.push(refPrices[i] > refPrices[0] ? 'Bull' : 'Bear');
                }
            }
            
            const volRegimes = [];
            const rollingVols = [];
            
            for (let i = 0; i < barReturns.length; i++) {
                if (i >= smaLen) {
                    const slice = barReturns.slice(i - smaLen, i);
                    const mean = slice.reduce((a,b)=>a+b, 0) / smaLen;
                    const variance = slice.reduce((a,b) => a + Math.pow(b - mean, 2), 0) / smaLen;
                    rollingVols.push(Math.sqrt(variance));
                } else {
                    rollingVols.push(0.0);
                }
            }
            
            const sortedVols = [...rollingVols].sort((a, b) => a - b);
            const medianVol = sortedVols[Math.floor(sortedVols.length / 2)] || 0.001;
            
            rollingVols.forEach(v => {
                volRegimes.push(v > medianVol ? 'Volatile' : 'Quiet');
            });
            
            const grouped = {
                'Quiet Bull': { trades: 0, pnl: [], returns: [] },
                'Quiet Bear': { trades: 0, pnl: [], returns: [] },
                'Volatile Bull': { trades: 0, pnl: [], returns: [] },
                'Volatile Bear': { trades: 0, pnl: [], returns: [] }
            };
            
            rows.forEach((r, idx) => {
                const trend = trendRegimes[idx];
                const vol = volRegimes[idx];
                const regKey = `${vol} ${trend}`;
                
                if (grouped[regKey]) {
                    const barRet = parseFloat(r.bar_return) || 0.0;
                    const barPnl = parseFloat(r.bar_pnl) || 0.0;
                    const decisionStr = r.decision || '';
                    
                    grouped[regKey].returns.push(barRet);
                    grouped[regKey].pnl.push(barPnl);
                    
                    if (decisionStr && decisionStr.trim() !== "" && decisionStr !== "0" && decisionStr !== "0.0") {
                        grouped[regKey].trades++;
                    }
                }
            });
            
            const tbody = document.getElementById('quantlab-regime-body');
            tbody.innerHTML = Object.keys(grouped).map(regKey => {
                const stats = grouped[regKey];
                const count = stats.pnl.length;
                let winCount = stats.pnl.filter(p => p > 0).length;
                let tradeCount = stats.trades;
                let winRate = tradeCount > 0 ? (winCount / tradeCount * 100).toFixed(1) + '%' : '—';
                let avgPnl = count > 0 ? (stats.returns.reduce((a,b)=>a+b, 0)/count * 100).toFixed(4) + '%' : '0.0000%';
                
                let sharpe = '—';
                if (count > 10) {
                    const mean = stats.returns.reduce((a,b)=>a+b,0)/count;
                    const variance = stats.returns.reduce((a,b)=>a+Math.pow(b-mean,2),0)/count;
                    const sd = Math.sqrt(variance);
                    if (sd > 0) {
                        sharpe = ((mean / sd) * Math.sqrt(1512)).toFixed(2);
                    }
                }
                
                return `
                    <tr class="hover:bg-[#1A1A22]/40 transition-colors border-b border-[#2B2B36]/10 text-[9px] font-mono">
                        <td class="p-2 font-semibold text-white">${regKey}</td>
                        <td class="p-2 text-right text-gray-300">${tradeCount}</td>
                        <td class="p-2 text-right text-emerald-400 font-bold">${winRate}</td>
                        <td class="p-2 text-right text-gray-300">${avgPnl}</td>
                        <td class="p-2 text-right text-white font-semibold">${sharpe}</td>
                    </tr>
                `;
            }).join('');
        }

