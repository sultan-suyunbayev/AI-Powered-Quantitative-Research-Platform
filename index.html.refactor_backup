        function highlightAssetCard(assetClass) {
            const cards = ['equity', 'forex', 'futures', 'crypto', 'options'];
            cards.forEach(c => {
                const card = document.getElementById(`asset-card-${c}`);
                if (card) {
                    if (c === assetClass) {
                        card.classList.remove('bg-[#1A1A22]', 'border-[#2B2B36]');
