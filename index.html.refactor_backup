        async function fetchAnalyticsExecution() {
            try {
                const telRes = await fetch(API_BASE + '/api/telemetry/live');
                if (!telRes.ok) return;
                const telData = await telRes.json();
                
                // Set clock sync timings
                const sync = telData.clock_sync || {};
                document.getElementById('lite-latency-rtt').innerText = sync.rtt_ms !== undefined ? sync.rtt_ms + ' ms' : '—';
                document.getElementById('lite-latency-drift').innerText = sync.drift_ms !== undefined ? sync.drift_ms + ' ms' : '—';

                // Set websocket timing
                const liveMetrics = telData.live_metrics || {};
                let lastWs = '—';
                if (liveMetrics.ts_ms) {
                    lastWs = 'ts_ms: ' + liveMetrics.ts_ms;
                } else if (sync.last_sync) {
                    lastWs = 'NTP: ' + sync.last_sync;
                }
                document.getElementById('lite-latency-ws-ts').innerText = lastWs;

                // Slippage stats from eval/results
                const evalRes = await fetch(API_BASE + '/api/eval/results');
                let slipBps = 0.8; // Baseline mock default
                if (evalRes.ok) {
                    const metrics = await evalRes.json();
                    const activeAssetKey = (activeAsset || 'equity').toLowerCase();
                    const assetMetrics = metrics[activeAssetKey] || metrics['equity'] || {};
                    const trMetrics = assetMetrics.trades || {};
                    if (trMetrics.avg_slippage_bps !== undefined && !isNaN(trMetrics.avg_slippage_bps)) {
                        slipBps = trMetrics.avg_slippage_bps;
                    }
                }
                
                const slipValEl = document.getElementById('lite-avg-slippage-val');
                const badge = document.getElementById('slippage-badge');
                const progressBar = document.getElementById('slippage-progress');
                
                if (slipValEl && badge && progressBar) {
                    slipValEl.innerText = slipBps.toFixed(2) + ' BPS';
                    
                    // Calculate visual metrics
                    let pct = Math.min(100, (slipBps / 3.0) * 100);
                    progressBar.style.width = pct + '%';
                    
                    if (slipBps < 0.5) {
                        badge.innerText = 'Отличное';
                        badge.className = "bg-emerald-500/10 text-emerald-400 border border-emerald-500/10 text-[10px] px-2.5 py-1 rounded-lg font-mono";
                        progressBar.className = "bg-emerald-400 h-full transition-all duration-500";
