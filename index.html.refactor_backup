            const dataPath = defaultDataPaths[activeAsset] || "data/prices.parquet";
            
            try {
                const res = await fetch(API_BASE + '/api/run_job', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        job: '/backtest',
                        params: {
                            is_custom_strategy: true,
                            initial_cash: parseFloat(capital),
                            data_path: dataPath,
                            latency: parseFloat(latency),
                            fee: parseFloat(fee),
                            no_filter_hours: !filterHours
                        }
                    })
                });
                
                if (res.ok) {
                    const data = await res.json();
                    showActionToast(`Экспресс-бэктест запущен (PID: ${data.pid})`);
                    
                    coderBacktestInterval = setInterval(async () => {
                        const logRes = await fetch(API_BASE + '/api/logs?name=backtest.log');
                        if (logRes.ok) {
                            const text = await logRes.text();
                            logPre.innerText = text || "Загрузка логов...";
                            consoleEl.scrollTop = consoleEl.scrollHeight;
                        }
                        
                        const statusRes = await fetch(API_BASE + '/api/job/status?job=backtest');
                        if (statusRes.ok) {
                            const statusData = await statusRes.json();
                            if (!statusData.running) {
                                stopCoderBacktestPolling();
                                runCoderEvaluation(parseFloat(capital));
