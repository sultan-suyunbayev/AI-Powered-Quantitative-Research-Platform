            try {
                const res = await fetch(API_BASE + '/api/run_job', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        job: 'run_tuner',
                        params: {
                            target_signals_per_day: target,
                            tolerance: tolerance,
                            optimize_for: metric,
                            data: dataPath
                        }
                    })
                });
                
                if (res.ok) {
                    const data = await res.json();
                    showActionToast(`Подбор порогов запущен. PID: ${data.pid}`);
                    
                    let tunerInterval = setInterval(async () => {
                        try {
                            const statusRes = await fetch(API_BASE + '/api/job/status?job=run_tuner');
                            if (statusRes.ok) {
                                const statusData = await statusRes.json();
                                if (!statusData.running) {
