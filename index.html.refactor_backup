                params.open_col = "open";
                params.high_col = "high";
                params.low_col = "low";
                
                const useParkinson = document.getElementById('feat-use-parkinson')?.checked;
                const useYangZhang = document.getElementById('feat-use-yangzhang')?.checked;
                if (useParkinson) {
                    params.parkinson_windows = document.getElementById('feat-parkinson-windows').value;
                }
                if (useYangZhang) {
                    params.yang_zhang_windows = document.getElementById('feat-yang-zhang-windows').value;
                }
            } else if (asset === 'crypto') {
                const volCol = document.getElementById('feat-volume-col').value;
                const takerCol = document.getElementById('feat-taker-buy-base-col').value;
                if (volCol) params.volume_col = volCol;
                if (takerCol) params.taker_buy_base_col = takerCol;
                
                params.cvd_windows = document.getElementById('feat-cvd-windows').value;
                params.taker_buy_ratio_windows = document.getElementById('feat-taker-windows').value;
                params.taker_buy_ratio_momentum = document.getElementById('feat-taker-momentum').value;
                
                params.open_col = "open";
                params.high_col = "high";
