                const wfPnl = document.getElementById('workflow-telemetry-pnl');
                const wfSharpe = document.getElementById('workflow-telemetry-sharpe');
                const wfMaxdd = document.getElementById('workflow-telemetry-maxdd');
                const wfEquity = document.getElementById('workflow-telemetry-equity');
                const wfSignaler = document.getElementById('workflow-signaler-badge');

                if (wfPnl) {
                    wfPnl.innerText = data.metrics.pnl_total;
                    if (data.metrics.pnl_total && data.metrics.pnl_total.includes('+')) {
                        wfPnl.className = 'text-xs font-semibold text-emerald-400 font-mono';
                    } else if (data.metrics.pnl_total && data.metrics.pnl_total.includes('-')) {
                        wfPnl.className = 'text-xs font-semibold text-rose-400 font-mono';
                    } else {
                        wfPnl.className = 'text-xs font-semibold text-white font-mono';
                    }
                }
                if (wfSharpe) wfSharpe.innerText = data.metrics.sharpe;
                if (wfMaxdd) wfMaxdd.innerText = data.metrics.max_drawdown;
                if (wfEquity) wfEquity.innerText = data.metrics.equity;
                if (wfSignaler) {
                    if (data.signaler_running) {
                        wfSignaler.innerText = 'live_node';
                        wfSignaler.className = 'text-[9px] font-mono px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20';
