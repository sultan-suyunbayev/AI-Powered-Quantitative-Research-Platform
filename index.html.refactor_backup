        function submitIngestConfig() {
            const asset = activeAsset;
            let custom_config = {};
            
            const start = document.getElementById('ingest-start').value;
            const end = document.getElementById('ingest-end').value;
            if (!start || !end) {
                alert("Пожалуйста, заполните даты начала и окончания периода.");
                return;
            }
            
            if (asset === 'equity') {
                const symbolsInput = document.getElementById('ingest-symbols').value;
                const symbols = symbolsInput.split(',').map(s => s.trim().toUpperCase()).filter(s => s.length > 0);
                if (symbols.length === 0) {
                    alert("Пожалуйста, введите хотя бы один тикер.");
                    return;
                }
                const provider = document.getElementById('ingest-provider').value;
                const timeframe = document.getElementById('ingest-timeframe').value;
                
                let apiKey = "";
                let apiSecret = "";
                let feed = "iex";
                if (provider === 'alpaca') {
                    apiKey = document.getElementById('ingest-api-key').value;
                    apiSecret = document.getElementById('ingest-api-secret').value;
                    feed = document.getElementById('ingest-feed').value;
                } else if (provider === 'polygon') {
                    apiKey = document.getElementById('ingest-polygon-key').value;
                }
                
                const includeExtended = document.getElementById('ingest-include-extended').checked;
                const filterHours = document.getElementById('ingest-filter-hours').checked;
                const skipExisting = document.getElementById('ingest-skip-existing').checked;
                const macro = document.getElementById('ingest-macro').checked;
                const resample = document.getElementById('ingest-resample').value;
                const workers = parseInt(document.getElementById('ingest-workers').value) || 4;
                
                custom_config = {
                    symbols: symbols,
                    provider: provider,
                    timeframe: timeframe,
                    period: { start: start, end: end },
                    api_key: apiKey,
                    api_secret: apiSecret,
                    feed: feed,
                    include_extended: includeExtended,
                    no_filter_hours: !filterHours,
                    no_skip_existing: !skipExisting,
                    macro: macro,
                    resample: resample,
                    workers: workers
                };
            } else if (asset === 'forex') {
                const symbolsInput = document.getElementById('ingest-symbols').value;
                const symbols = symbolsInput.split(',').map(s => s.trim().toUpperCase().replace('/', '_')).filter(s => s.length > 0);
