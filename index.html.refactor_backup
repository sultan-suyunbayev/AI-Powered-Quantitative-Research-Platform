        async function loadWalkForwardManifest() {
            const timelineContainer = document.getElementById('quantlab-wf-timeline');
            timelineContainer.innerHTML = `<p class="text-center text-gray-500 font-mono text-xs py-4"><i class="fa-solid fa-circle-notch fa-spin mr-1"></i> Загрузка манифеста...</p>`;
            
            try {
                const res = await fetch(API_BASE + '/api/json/get_file?path=logs/walkforward/walkforward_manifest.json');
                if (!res.ok) {
                    throw new Error("Манифест сплитов не найден на сервере. Сгенерируйте сплиты.");
                }
                
                const manifest = await res.json();
                if (!manifest || manifest.length === 0) {
                    timelineContainer.innerHTML = `<p class="text-center text-gray-500 font-mono text-xs py-4">Манифест пуст.</p>`;
                    return;
                }
                
                const minTs = Math.min(...manifest.map(m => m.train_start_ts));
                const maxTs = Math.max(...manifest.map(m => m.val_end_ts));
                const totalDur = maxTs - minTs;
                
                if (totalDur <= 0) {
                    timelineContainer.innerHTML = `<p class="text-center text-red-400 font-mono text-xs py-4">Некорректная длительность сплитов в манифесте.</p>`;
                    return;
                }
                
                timelineContainer.innerHTML = manifest.map(m => {
                    const trainStartPct = ((m.train_start_ts - minTs) / totalDur) * 100;
                    const trainEndEffPct = ((m.train_end_ts_effective - minTs) / totalDur) * 100;
                    const trainEndRawPct = ((m.train_end_ts_raw - minTs) / totalDur) * 100;
                    const valStartPct = ((m.val_start_ts - minTs) / totalDur) * 100;
                    const valEndPct = ((m.val_end_ts - minTs) / totalDur) * 100;
                    
                    const trainWidth = Math.max(0, trainEndEffPct - trainStartPct);
                    const purgeWidth = Math.max(0, trainEndRawPct - trainEndEffPct);
                    const embargoWidth = Math.max(0, valStartPct - trainEndRawPct);
                    const valWidth = Math.max(0, valEndPct - valStartPct);
                    
                    const formatTime = (ts) => {
                        const d = new Date(ts);
                        return d.toLocaleDateString() + ' ' + d.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
                    };
                    
                    return `
                        <div class="flex items-center gap-3 py-1.5 border-b border-[#2B2B36]/10">
                            <div class="w-16 shrink-0 text-[10px] text-gray-400 font-mono font-bold">Fold ${m.fold_id}</div>
                            <div class="flex-1 h-5 rounded-lg overflow-hidden bg-[#17171C] flex relative border border-[#2B2B36]/20 shadow-inner">
                                ${trainStartPct > 0.05 ? `<div style="width: ${trainStartPct}%" class="bg-slate-700/10 h-full"></div>` : ''}
                                <div style="width: ${trainWidth}%" class="bg-purple-600/85 hover:bg-purple-500 transition-colors h-full flex items-center justify-center text-[8px] font-bold text-white truncate cursor-help" title="Обучение: ${formatTime(m.train_start_ts)} - ${formatTime(m.train_end_ts_effective)} (${m.train_count} б.)">Train</div>
                                ${purgeWidth > 0.05 ? `<div style="width: ${purgeWidth}%" class="bg-rose-500/85 hover:bg-rose-400 transition-colors h-full flex items-center justify-center text-[7px] text-white truncate cursor-help" title="Очистка (Purge): ${formatTime(m.train_end_ts_effective)} - ${formatTime(m.train_end_ts_raw)}">Purge</div>` : ''}
                                ${embargoWidth > 0.05 ? `<div style="width: ${embargoWidth}%" class="bg-amber-500/85 hover:bg-amber-400 transition-colors h-full flex items-center justify-center text-[7px] text-white truncate cursor-help" title="Буфер (Embargo): ${formatTime(m.train_end_ts_raw)} - ${formatTime(m.val_start_ts)}">Embargo</div>` : ''}
                                <div style="width: ${valWidth}%" class="bg-emerald-500/85 hover:bg-emerald-400 transition-colors h-full flex items-center justify-center text-[8px] font-bold text-white truncate cursor-help" title="Валидация: ${formatTime(m.val_start_ts)} - ${formatTime(m.val_end_ts)} (${m.val_count} б.)">Val</div>
                                ${(100 - valEndPct) > 0.05 ? `<div style="width: ${100 - valEndPct}%" class="bg-slate-700/10 h-full"></div>` : ''}
                            </div>
                            <div class="text-[8px] font-mono text-gray-500 shrink-0 w-24 text-right">${m.train_count + m.val_count} б.</div>
                        </div>
                    `;
                }).join('');
            } catch (err) {
                timelineContainer.innerHTML = `<p class="text-center text-amber-500/70 font-mono text-xs py-4">${err.message}</p>`;
            }
        }

