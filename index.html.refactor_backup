                    return;
                }
                const provider = document.getElementById('ingest-provider').value;
                const timeframe = document.getElementById('ingest-timeframe').value;
                const rollover = document.getElementById('ingest-rollover').value;
                const adjust = document.getElementById('ingest-adjust').value;
                const skipExisting = document.getElementById('ingest-skip-existing').checked;
                const filterHours = document.getElementById('ingest-filter-hours').checked;
                
                custom_config = {
                    symbols: symbols,
                    provider: provider,
                    timeframe: timeframe,
                    period: { start: start, end: end },
                    rollover: rollover,
                    adjust: adjust,
                    no_skip_existing: !skipExisting,
                    no_filter_hours: !filterHours
                };
            } else if (asset === 'crypto') {
                const symbolsInput = document.getElementById('ingest-symbols').value;
                const symbols = symbolsInput.split(',').map(s => s.trim().toUpperCase()).filter(s => s.length > 0);
                if (symbols.length === 0) {
