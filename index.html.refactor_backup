        // State handlers
        async function fetchSystemState() {
            try {
                const res = await fetch(API_BASE + '/api/system_state');
                if (res.ok) {
                    const data = await res.json();
                    activeAsset = data.active_asset;
                    activeAdapter = data.active_adapter;
                    highlightAssetCard(activeAsset);
                    populateAdapterSelect(activeAsset, activeAdapter);
                    updateUIContext();
                }
            } catch (err) {
                console.error("Error loading system state:", err);
            }
        }

        async function selectAsset(assetClass) {
            activeAsset = assetClass;
            activeAdapter = adaptersByAsset[assetClass][0];
            
            highlightAssetCard(assetClass);
            populateAdapterSelect(assetClass, activeAdapter);
            updateUIContext();

            if (currentProductMode === 'lite') {
                const panel = document.getElementById('lite-workflow-panel');
                const welcome = document.getElementById('lite-welcome-header');
                const selector = document.getElementById('lite-asset-selector-card');
                const bottomCards = document.getElementById('home-lite-bottom-cards');
                
                if (welcome) welcome.classList.add('opacity-0', '-translate-y-4');
                if (selector) selector.classList.add('opacity-0', 'translate-y-4');
                if (bottomCards) bottomCards.classList.add('opacity-0', 'translate-y-4');
                
                setTimeout(() => {
                    if (welcome) welcome.classList.add('hidden');
                    if (selector) selector.classList.add('hidden');
                    if (bottomCards) bottomCards.classList.add('hidden');

                    if (panel) {
                        panel.classList.remove('hidden');
                        panel.offsetHeight; // reflow
                        panel.classList.remove('opacity-0', 'translate-y-4');
                        panel.classList.add('opacity-100', 'translate-y-0');
                    }
                    
                    renderWorkflowTimeline(assetClass);
                }, 300);
            }

            try {
