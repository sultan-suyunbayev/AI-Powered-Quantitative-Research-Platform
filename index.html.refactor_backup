        async function triggerPanicHalt() {
            const confirmHalt = confirm("ВНИМАНИЕ: Вы действительно хотите запустить экстренную ликвидацию Panic Halt?");
            if (!confirmHalt) return;

            const panicBtn = document.getElementById('panic-halt-btn');
            if (panicBtn) {
                panicBtn.innerText = "Ликвидация...";
                panicBtn.disabled = true;
            }

            try {
                const res = await fetch(API_BASE + '/api/panic_halt', { method: 'POST' });
                if (res.ok) {
                    const data = await res.json();
                    
                    document.getElementById('live-telemetry-default').classList.add('hidden');
                    document.getElementById('live-telemetry-content').classList.remove('hidden');
                    
                    document.getElementById('live-telemetry-mode').innerText = data.execution_mode || 'mock_simulated';
                    document.getElementById('live-telemetry-orders-cancelled').innerText = data.orders_cancelled || '0';
                    
                    const posContainer = document.getElementById('live-telemetry-positions');
                    posContainer.innerHTML = "";
                    if (data.positions_liquidated && data.positions_liquidated.length > 0) {
                        data.positions_liquidated.forEach(p => {
                            const div = document.createElement('div');
                            div.className = "flex justify-between border-b border-[#232329]/40 py-1 last:border-b-0";
                            div.innerHTML = `<span>${p.symbol} (${p.side})</span><span>${p.qty} @ $${p.price} (Val: $${p.value})</span>`;
                            posContainer.appendChild(div);
                        });
                    } else {
                        posContainer.innerHTML = "<div class='text-gray-500 text-center py-2'>Нет активных позиций для ликвидации</div>";
                    }

                    const reportContainer = document.getElementById('live-telemetry-quant-report');
                    reportContainer.innerHTML = "";
                    const qr = data.quant_report || {};
                    for (const key in qr) {
                        const div = document.createElement('div');
                        div.className = "bg-[#1A1A22]/20 border border-[#2B2B36]/40 p-2 rounded-lg font-mono text-[10px]";
                        div.innerHTML = `<span class='text-gray-500 block uppercase'>${key.replace(/_/g, ' ')}:</span><span class='text-white font-semibold'>${qr[key]}</span>`;
                        reportContainer.appendChild(div);
                    }

                    document.getElementById('live-killswitch-status-badge').innerText = "TRIPPED (HALTED)";
                    document.getElementById('live-killswitch-status-badge').className = "text-red-500 font-semibold";
                    document.getElementById('live-algo-status-badge').innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-red-500"></span> АВАРИЙНЫЙ ОСТАНОВ`;
                    
                    document.getElementById('reset-killswitch-btn').classList.remove('hidden');
                    showActionToast("Аварийный Panic Halt выполнен успешно!");
                }
            } catch (err) {
                alert(`Ошибка экстренной ликвидации: ${err.message}`);
            } finally {
                if (panicBtn) {
                    panicBtn.innerText = "Panic Halt";
                    panicBtn.disabled = false;
                }
            }
        }

