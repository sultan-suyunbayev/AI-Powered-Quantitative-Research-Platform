<!DOCTYPE html>
<html lang="ru" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RivenQuant AI Advanced Platform</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    }
                }
            }
        }
    </script>
    <style>
        html { background-color: #0E0E11; }
        body { background-color: #0E0E11; color: #E3E3E3; font-feature-settings: "cv02", "cv03", "cv04", "cv11"; }
        .gemini-blur { backdrop-filter: blur(16px); background-color: rgba(22, 22, 26, 0.7); }
        .gemini-gradient { background: linear-gradient(135deg, #4A76FD 0%, #9D4EDD 50%, #FF5A92 100%); }
        .text-gradient { background: linear-gradient(90deg, #A3C2FF 0%, #E2A7FF 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .custom-scrollbar::-webkit-scrollbar { width: 4px; height: 4px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #2A2A32; border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #3F3F4E; }
        .active-glow { box-shadow: 0 0 20px rgba(74, 118, 253, 0.15); border-color: rgba(74, 118, 253, 0.4); }

        /* Premium Flat Button Styles */
        .btn-gradient {
            background-color: #2563eb !important; /* bg-blue-600 */
            color: #ffffff !important;
            border: 1px solid #3b82f6 !important;
            transition: all 0.2s ease-in-out !important;
        }
        .btn-gradient:hover {
            background-color: #3b82f6 !important; /* bg-blue-500 */
            box-shadow: 0 0 12px rgba(59, 130, 246, 0.4) !important;
        }
        .btn-gradient:active {
            transform: scale(0.98) !important;
        }

        .copilot-btn-gradient {
            background-color: #1A1A22 !important;
            color: #e2e8f0 !important;
            border: 1px solid #2B2B36 !important;
            transition: all 0.2s ease-in-out !important;
        }
        .copilot-btn-gradient:hover {
            background-color: #202029 !important;
            color: #ffffff !important;
            border-color: #4b5563 !important;
            box-shadow: 0 0 10px rgba(255, 255, 255, 0.05) !important;
        }
        .gradient-border-step {
            border: 1px solid transparent;
            background-image: linear-gradient(#131316, #131316), linear-gradient(135deg, rgba(74, 118, 253, 0.25) 0%, rgba(157, 78, 221, 0.25) 100%);
            background-origin: border-box;
            background-clip: padding-box, border-box;
            transition: all 0.2s ease-in-out;
        }
        .gradient-border-step:hover {
            background-image: linear-gradient(#17171C, #17171C), linear-gradient(135deg, rgba(74, 118, 253, 0.6) 0%, rgba(157, 78, 221, 0.6) 100%);
            box-shadow: 0 0 12px rgba(74, 118, 253, 0.08);
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="h-screen flex overflow-hidden font-sans text-sm antialiased">

    <!-- SIDEBAR -->
    <aside class="w-[16%] bg-[#131316] border-r border-[#232329] flex flex-col justify-between p-4 select-none z-30">
        <div class="space-y-6 overflow-hidden flex flex-col">
            <div class="flex items-center gap-3 px-2 py-1 cursor-pointer" onclick="switchModule('home')">
                <div class="w-7 h-7 rounded-full gemini-gradient flex items-center justify-center shadow-lg shadow-blue-500/10">
                    <i class="fa-solid fa-circle-nodes text-white text-xs"></i>
                </div>
                <span class="font-semibold text-sm tracking-wide text-white">RivenQuant <span class="text-[10px] text-blue-400 font-mono bg-blue-500/10 px-1 rounded">v2.6</span></span>
            </div>

            <!-- Product Mode Toggle (Lite vs Pro) -->
            <div class="px-1.5">
                <div class="flex p-0.5 bg-[#17171C] rounded-xl border border-[#2B2B36] select-none font-mono text-[10px] relative shrink-0 overflow-hidden">
                    <!-- Sliding active pill with bouncy spring animation -->
                    <div id="product-mode-slider" class="absolute top-[2px] bottom-[2px] left-[2px] w-[calc(50%-2px)] bg-blue-600 rounded-lg transition-transform duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] transform translate-x-0 pointer-events-none"></div>
                    
                    <button id="toggle-mode-lite" onclick="switchProductMode('lite')" class="flex-1 text-center py-1.5 rounded-lg text-white font-semibold transition-all duration-200 cursor-pointer z-10 bg-transparent">Lite</button>
                    <button id="toggle-mode-pro" onclick="switchProductMode('pro')" class="flex-1 text-center py-1.5 rounded-lg text-gray-400 hover:text-white transition-all duration-200 cursor-pointer z-10 bg-transparent">Pro</button>
                </div>
            </div>

            <div class="relative mx-1">
                <i class="fa-solid fa-filter absolute left-3 top-2.5 text-gray-500 text-xs"></i>
                <input type="text" id="sidebar-search" oninput="filterSidebarModules()" placeholder="Фильтр модулей..." class="w-full bg-[#1A1A22] border border-[#2B2B36] rounded-xl pl-8 pr-3 py-1.5 text-xs text-gray-300 outline-none focus:border-blue-500/50 font-medium transition-all placeholder-gray-600">
            </div>

            <nav class="flex-1 overflow-y-auto custom-scrollbar space-y-4 pr-1" id="sidebar-nav">
                
                <!-- Lite Mode Sidebar Navigation -->
                <div id="lite-nav-container" class="space-y-1.5 hidden flex flex-col mb-4">
                    <div class="text-[10px] font-semibold text-gray-500 uppercase tracking-wider px-2 mb-1"><i class="fa-solid fa-compass mr-1 text-blue-400"></i> Навигация Lite</div>
                    <button onclick="switchModule('home')" id="btn-home" class="w-full text-left px-3 py-2 rounded-xl text-xs hover:bg-[#1E1F24] text-white flex items-center gap-2.5 transition-colors font-medium border-l-2 border-blue-500 bg-[#1E1F24]">
                        <i class="fa-solid fa-rocket text-blue-400 text-[11px] w-4 text-center"></i>
                        <span>Быстрый старт</span>
                    </button>
                    <button onclick="switchModule('lite-data')" id="btn-lite-data" class="w-full text-left px-3 py-2 rounded-xl text-xs hover:bg-[#1E1F24] text-gray-400 flex items-center gap-2.5 transition-colors font-medium">
                        <i class="fa-solid fa-database text-sky-400 text-[11px] w-4 text-center"></i>
                        <span>Управление данными</span>
                    </button>
                    <button onclick="switchModule('lite-quantlab')" id="btn-lite-quantlab" class="w-full text-left px-3 py-2 rounded-xl text-xs hover:bg-[#1E1F24] text-gray-400 flex items-center gap-2.5 transition-colors font-medium">
                        <i class="fa-solid fa-flask text-amber-400 text-[11px] w-4 text-center"></i>
                        <span>Квантовая лаборатория</span>
                    </button>
                    <button onclick="switchModule('lite-analytics')" id="btn-lite-analytics" class="w-full text-left px-3 py-2 rounded-xl text-xs hover:bg-[#1E1F24] text-gray-400 flex items-center gap-2.5 transition-colors font-medium">
                        <i class="fa-solid fa-chart-line text-emerald-400 text-[11px] w-4 text-center"></i>
                        <span>Аналитика & Телеметрия</span>
                    </button>
                    <button onclick="switchModule('lite-agents')" id="btn-lite-agents" class="w-full text-left px-3 py-2 rounded-xl text-xs hover:bg-[#1E1F24] text-gray-400 flex items-center gap-2.5 transition-colors font-medium">
                        <i class="fa-solid fa-robot text-purple-400 text-[11px] w-4 text-center"></i>
                        <span>Управление агентами</span>
                    </button>
                    <button onclick="switchModule('lite-portfolio')" id="btn-lite-portfolio" class="w-full text-left px-3 py-2 rounded-xl text-xs hover:bg-[#1E1F24] text-gray-400 flex items-center gap-2.5 transition-colors font-medium">
                        <i class="fa-solid fa-briefcase text-pink-400 text-[11px] w-4 text-center"></i>
                        <span>Портфель & Риски</span>
                    </button>
                    <button onclick="switchModule('lite-history')" id="btn-lite-history" class="w-full text-left px-3 py-2 rounded-xl text-xs hover:bg-[#1E1F24] text-gray-400 flex items-center gap-2.5 transition-colors font-medium">
                        <i class="fa-solid fa-clock-rotate-left text-indigo-400 text-[11px] w-4 text-center"></i>
                        <span>История сделок</span>
                    </button>
                    <button onclick="switchModule('lite-strategy-coder')" id="btn-lite-strategy-coder" class="w-full text-left px-3 py-2 rounded-xl text-xs hover:bg-[#1E1F24] text-gray-400 flex items-center gap-2.5 transition-colors font-medium">
                        <i class="fa-solid fa-laptop-code text-violet-400 text-[11px] w-4 text-center"></i>
                        <span>Ручные стратегии</span>
                    </button>
                </div>

                <div class="category-block" data-category="📊 Панель управления Dashboard">
                    <div class="text-[10px] font-semibold text-gray-500 uppercase tracking-wider px-2 mb-1"><i class="fa-solid fa-chart-simple mr-1"></i> Панель управления</div>
                    <div class="space-y-0.5">
                        <button onclick="switchModule('status')" id="btn-status" class="w-full text-left px-3 py-1.5 rounded-lg text-xs hover:bg-[#1E1F24] text-gray-400 flex items-center justify-between transition-colors"><span>1. Status</span><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span></button>
                        <button onclick="switchModule('realtime-signaler')" id="btn-realtime-signaler" class="w-full text-left px-3 py-1.5 rounded-lg text-xs hover:bg-[#1E1F24] text-gray-400 transition-colors">2. Realtime Signaler</button>
                        <button onclick="switchModule('execution')" id="btn-execution" class="w-full text-left px-3 py-1.5 rounded-lg text-xs hover:bg-[#1E1F24] text-gray-400 flex items-center justify-between transition-colors"><span>3. Исполнение</span><span id="badge-exec" class="bg-amber-500/10 text-amber-400 text-[10px] px-1.5 rounded font-mono border border-amber-500/20">0</span></button>
                        <button onclick="switchModule('logs')" id="btn-logs" class="w-full text-left px-3 py-1.5 rounded-lg text-xs hover:bg-[#1E1F24] text-gray-400 transition-colors">4. Логи</button>
                        <button onclick="switchModule('monitoring')" id="btn-monitoring" class="w-full text-left px-3 py-1.5 rounded-lg text-xs hover:bg-[#1E1F24] text-gray-400 transition-colors">5. Monitoring</button>
                        <button onclick="switchModule('drift-monitor')" id="btn-drift-monitor" class="w-full text-left px-3 py-1.5 rounded-lg text-xs hover:bg-[#1E1F24] text-gray-400 transition-colors">6. Drift Monitor</button>
                        <button onclick="switchModule('pdt-margin-guard')" id="btn-pdt-margin-guard" data-assets="equity" class="w-full text-left px-3 py-1.5 rounded-lg text-xs hover:bg-[#1E1F24] text-gray-400 transition-colors"><i class="fa-solid fa-shield-halved mr-1 text-blue-400"></i> PDT & Margin Guard</button>
                        <button onclick="switchModule('forex-swaps')" id="btn-forex-swaps" data-assets="forex" class="w-full text-left px-3 py-1.5 rounded-lg text-xs hover:bg-[#1E1F24] text-gray-400 transition-colors"><i class="fa-solid fa-rotate-left mr-1 text-emerald-400"></i> Forex Swaps Monitor</button>
                        <button onclick="switchModule('futures-span-margin')" id="btn-futures-span-margin" data-assets="futures" class="w-full text-left px-3 py-1.5 rounded-lg text-xs hover:bg-[#1E1F24] text-gray-400 transition-colors"><i class="fa-solid fa-chart-pie mr-1 text-purple-400"></i> CME SPAN Margin</button>
                        <button onclick="switchModule('options-greeks')" id="btn-options-greeks" data-assets="options" class="w-full text-left px-3 py-1.5 rounded-lg text-xs hover:bg-[#1E1F24] text-gray-400 transition-colors"><i class="fa-solid fa-calculator mr-1 text-pink-400"></i> Options Greeks Solver</button>
                    </div>
                </div>

                <div class="category-block" data-category="💾 Данные и фичи Data Pipeline">
                    <div class="text-[10px] font-semibold text-gray-500 uppercase tracking-wider px-2 mb-1"><i class="fa-solid fa-database mr-1"></i> Данные и фичи</div>
                    <div class="space-y-0.5">
                        <button onclick="switchModule('ingest')" id="btn-ingest" class="w-full text-left px-3 py-1.5 rounded-lg text-xs hover:bg-[#1E1F24] text-gray-400 transition-colors">7. Ingest</button>
                        <button onclick="switchModule('features')" id="btn-features" class="w-full text-left px-3 py-1.5 rounded-lg text-xs hover:bg-[#1E1F24] text-gray-400 transition-colors">8. Features</button>
                        <button onclick="switchModule('target-builder')" id="btn-target-builder" class="w-full text-left px-3 py-1.5 rounded-lg text-xs hover:bg-[#1E1F24] text-gray-400 transition-colors">9. Target Builder</button>
                        <button onclick="switchModule('training-table')" id="btn-training-table" class="w-full text-left px-3 py-1.5 rounded-lg text-xs hover:bg-[#1E1F24] text-gray-400 transition-colors">10. Training Table</button>
                        <button onclick="switchModule('no-trade-mask')" id="btn-no-trade-mask" class="w-full text-left px-3 py-1.5 rounded-lg text-xs hover:bg-[#1E1F24] text-gray-400 transition-colors">11. No-Trade Mask</button>
                    </div>
                </div>

                <div class="category-block" data-category="🧠 Исследования и RL ML Research">
                    <div class="text-[10px] font-semibold text-gray-500 uppercase tracking-wider px-2 mb-1"><i class="fa-solid fa-brain mr-1"></i> Исследования и RL</div>
                    <div class="space-y-0.5">
                        <button onclick="switchModule('walk-forward-splits')" id="btn-walk-forward-splits" class="w-full text-left px-3 py-1.5 rounded-lg text-xs hover:bg-[#1E1F24] text-gray-400 transition-colors">12. Walk-Forward Splits</button>
                        <button onclick="switchModule('model-train')" id="btn-model-train" class="w-full text-left px-3 py-1.5 rounded-lg text-xs hover:bg-[#1E1F24] text-gray-400 transition-colors">13. Model Train</button>
                        <button onclick="switchModule('probability-calibration')" id="btn-probability-calibration" class="w-full text-left px-3 py-1.5 rounded-lg text-xs hover:bg-[#1E1F24] text-gray-400 transition-colors">14. Probability Calib.</button>
                        <button onclick="switchModule('threshold-tuner')" id="btn-threshold-tuner" class="w-full text-left px-3 py-1.5 rounded-lg text-xs hover:bg-[#1E1F24] text-gray-400 transition-colors">15. Threshold Tuner</button>
                        <button onclick="switchModule('tcost-calibrate')" id="btn-tcost-calibrate" class="w-full text-left px-3 py-1.5 rounded-lg text-xs hover:bg-[#1E1F24] text-gray-400 transition-colors">16. T-cost Calibrate</button>
                    </div>
                </div>

                <div class="category-block" data-category="🧪 Бэктест и оценка Backtesting">
                    <div class="text-[10px] font-semibold text-gray-500 uppercase tracking-wider px-2 mb-1"><i class="fa-solid fa-flask mr-1"></i> Бэктест и оценка</div>
                    <div class="space-y-0.5">
                        <button onclick="switchModule('sandbox-backtest')" id="btn-sandbox-backtest" class="w-full text-left px-3 py-1.5 rounded-lg text-xs hover:bg-[#1E1F24] text-gray-400 transition-colors">17. Sandbox Backtest</button>
                        <button onclick="switchModule('evaluate')" id="btn-evaluate" class="w-full text-left px-3 py-1.5 rounded-lg text-xs hover:bg-[#1E1F24] text-gray-400 transition-colors">18. Evaluate</button>
                        <button onclick="switchModule('full-pipeline')" id="btn-full-pipeline" class="w-full text-left px-3 py-1.5 rounded-lg text-xs bg-purple-950/20 text-purple-300 border border-purple-500/10 hover:bg-purple-900/20 flex items-center gap-1.5 font-medium transition-all"><i class="fa-solid fa-bolt text-purple-400 text-[10px]"></i> 19. Полный прогон</button>
                    </div>
                </div>

                <div class="category-block" data-category="⚙️ Настройки системы Settings">
                    <div class="text-[10px] font-semibold text-gray-500 uppercase tracking-wider px-2 mb-1"><i class="fa-solid fa-sliders mr-1"></i> Настройки системы</div>
                    <div class="space-y-0.5">
                        <button onclick="switchModule('yaml-editor')" id="btn-yaml-editor" class="w-full text-left px-3 py-1.5 rounded-lg text-xs hover:bg-[#1E1F24] text-gray-400 transition-colors">20. YAML-редактор</button>
                        <button onclick="switchModule('sim-settings')" id="btn-sim-settings" class="w-full text-left px-3 py-1.5 rounded-lg text-xs hover:bg-[#1E1F24] text-gray-400 transition-colors">21. Sim Settings</button>
                        <button onclick="switchModule('offline-jobs')" id="btn-offline-jobs" class="w-full text-left px-3 py-1.5 rounded-lg text-xs hover:bg-[#1E1F24] text-gray-400 transition-colors">22. Offline Jobs</button>
                    </div>
                </div>
            </nav>
        </div>

        <div class="border-t border-[#232329] pt-3 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <div class="w-6 h-6 rounded-lg bg-[#1E1F24] border border-[#2B2B36] flex items-center justify-center text-gray-400 text-xs font-mono">Q</div>
                <div class="leading-none">
                    <span class="text-xs font-medium text-white block">QuantCore</span>
                    <span class="text-[9px] text-gray-500 font-mono">HFT_NODE_OK</span>
                </div>
            </div>
            <button onclick="switchModule('home')" class="text-gray-500 hover:text-white p-1 transition-colors text-xs"><i class="fa-solid fa-house"></i></button>
        </div>
    </aside>

    <!-- MAIN AREA -->
    <main class="flex-1 bg-[#0E0E11] flex flex-col relative overflow-y-auto custom-scrollbar border-r border-[#232329]/40">
        
        <div class="h-12 px-6 border-b border-[#232329]/20 flex items-center justify-between sticky top-0 bg-[#0E0E11]/90 backdrop-blur z-20">
            <div class="text-xs font-medium text-gray-500 font-mono flex items-center gap-2">
                <span>SYSTEM_CLOCK: <span class="text-gray-300" id="live-clock">14:22:50 UTC</span></span>
            </div>
            <div class="flex items-center gap-3">
                <button onclick="toggleCopilot()" class="px-2.5 py-1 rounded-lg border border-[#2B2B36] bg-[#1A1A22] text-[10px] text-gray-300 hover:text-white hover:border-gray-500 transition-all duration-200 cursor-pointer flex items-center gap-1.5 font-mono shadow-sm">
                    <i class="fa-solid fa-robot text-blue-400"></i> AI Copilot
                </button>
                <div id="signaler-node-badge" class="flex items-center gap-1.5 text-[11px] text-emerald-400 bg-emerald-500/5 px-2 py-0.5 rounded-md border border-emerald-500/10 font-mono">
                    <span id="signaler-dot" class="w-1 h-1 rounded-full bg-emerald-400 animate-pulse"></span> <span id="signaler-badge-text">live_node</span>
                </div>
            </div>
        </div>

        <div class="p-8 flex-1 flex flex-col" id="workspace">

            <!-- MODULE: HOME -->
            <div id="module-home" class="space-y-6 my-auto py-4">
                <!-- LITE CONTENT FOR HOME MODULE -->
                <div id="home-lite-content" class="space-y-6">
                    <div class="space-y-3 transition-all duration-300 transform opacity-100 scale-100" id="lite-welcome-header">
                        <h1 class="text-3xl font-light tracking-tight text-white">Какую задачу <span class="font-medium text-gradient">решаем сегодня?</span></h1>
                        <p class="text-gray-400 text-xs max-w-lg leading-relaxed">Количественное ядро RivenQuant инициализировано. Выберите целевой класс активов и брокерский адаптер для автоматической настройки конвейера данных, обучения RL-агентов и контроля риск-параметров.</p>
                    </div>

                    <!-- ACTIVE CONTEXT SELECTOR -->
                    <div id="lite-asset-selector-card" class="p-6 bg-[#131316]/80 border border-[#232329] rounded-3xl space-y-4 shadow-xl shadow-black/40 backdrop-blur-md relative overflow-hidden transition-all duration-300 transform opacity-100 scale-100">
                        <div class="absolute -top-12 -right-12 w-24 h-24 bg-blue-500/10 rounded-full blur-xl"></div>
                        <div class="absolute -bottom-12 -left-12 w-24 h-24 bg-purple-500/10 rounded-full blur-xl"></div>
                        
                        <div class="flex items-center justify-between border-b border-[#232329]/60 pb-3">
                            <div class="flex items-center gap-2">
                                <div class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></div>
                                <h3 class="text-xs font-semibold uppercase tracking-wider text-white font-mono">Активный контекст (Asset Class & Adapter)</h3>
                            </div>
                            <span class="text-[10px] text-gray-500 font-mono">System Dynamic Routing</span>
                        </div>
                        
                        <div class="grid grid-cols-5 gap-2" id="asset-selector-grid">
                            <div onclick="selectAsset('equity')" id="asset-card-equity" class="p-3 bg-[#1A1A22] border border-[#2B2B36] rounded-xl cursor-pointer hover:border-blue-500/30 hover:bg-[#202029] transition-all text-center space-y-1 group">
                                <div class="text-lg text-blue-400 group-hover:scale-105 transition-transform"><i class="fa-solid fa-chart-line"></i></div>
                                <div class="text-[11px] font-semibold text-white">US Equities</div>
                                <div class="text-[9px] text-gray-500 font-mono">EQUITY</div>
                            </div>
                            
                            <div onclick="selectAsset('forex')" id="asset-card-forex" class="p-3 bg-[#1A1A22] border border-[#2B2B36] rounded-xl cursor-pointer hover:border-emerald-500/30 hover:bg-[#202029] transition-all text-center space-y-1 group">
                                <div class="text-lg text-emerald-400 group-hover:scale-105 transition-transform"><i class="fa-solid fa-euro-sign"></i></div>
                                <div class="text-[11px] font-semibold text-white">Forex OTC</div>
                                <div class="text-[9px] text-gray-500 font-mono">FOREX</div>
                            </div>

                            <div onclick="selectAsset('futures')" id="asset-card-futures" class="p-3 bg-[#1A1A22] border border-[#2B2B36] rounded-xl cursor-pointer hover:border-purple-500/30 hover:bg-[#202029] transition-all text-center space-y-1 group">
                                <div class="text-lg text-purple-400 group-hover:scale-105 transition-transform"><i class="fa-solid fa-circle-nodes"></i></div>
                                <div class="text-[11px] font-semibold text-white">CME Futures</div>
                                <div class="text-[9px] text-gray-500 font-mono">FUTURES</div>
