        function drawCalibrationChart(model) {
            const canvas = document.getElementById('liteagents-calibration-chart');
            const placeholder = document.getElementById('liteagents-calibration-placeholder');
            if (!canvas) return;
            
            canvas.classList.remove('hidden');
            if (placeholder) placeholder.classList.add('hidden');
            
            const ctx = canvas.getContext('2d');
            const w = canvas.width;
            const h = canvas.height;
            ctx.clearRect(0, 0, w, h);
            
            // Margins
            const m = 25;
            const pw = w - 2*m;
            const ph = h - 2*m;
            
            // Draw Ideal line (diagonal)
            ctx.beginPath();
            ctx.strokeStyle = '#2B2B36';
            ctx.setLineDash([4, 4]);
            ctx.lineWidth = 1;
            ctx.moveTo(m, h - m);
            ctx.lineTo(w - m, m);
            ctx.stroke();
            ctx.setLineDash([]);
            
            // Draw axes
            ctx.beginPath();
            ctx.strokeStyle = '#232329';
            ctx.lineWidth = 1;
            ctx.moveTo(m, m);
            ctx.lineTo(m, h - m);
            ctx.lineTo(w - m, h - m);
            ctx.stroke();
            
            // Compute calibrated curve
            ctx.beginPath();
            ctx.strokeStyle = '#9D4EDD';
            ctx.lineWidth = 2.5;
            
            const points = [];
            const steps = 30;
            
            // Logistic Sigmoid helper
            const sigmoid = (z) => 1 / (1 + Math.exp(-z));
            
            for (let i = 0; i <= steps; i++) {
                const score = i / steps; // 0.0 to 1.0
                let prob = 0.5;
                
                if (model.type === 'platt') {
                    const z = model.w * score + model.b;
                    prob = sigmoid(z);
                } else if (model.type === 'isotonic') {
                    const xt = model.x_thresholds || [];
                    const yv = model.y_values || [];
                    let idx = xt.findIndex(val => val >= score);
                    if (idx === -1) {
                        prob = yv.length > 0 ? yv[yv.length - 1] : 0.5;
                    } else {
                        prob = yv[idx];
                    }
                }
                
                points.push({
                    x: m + score * pw,
                    y: h - m - prob * ph
                });
            }
            
            // Draw curve
            ctx.moveTo(points[0].x, points[0].y);
            for (let i = 1; i < points.length; i++) {
                ctx.lineTo(points[i].x, points[i].y);
            }
            ctx.stroke();
            
            // Legend / Labels
            ctx.fillStyle = '#676778';
            ctx.font = '8px monospace';
