        async function loadExistingTunerResults() {
            const tunerRec = document.getElementById('liteagents-tuner-recommendation');
            const tunerTbody = document.getElementById('liteagents-tuner-results-tbody');
            const tunerApplyBtn = document.getElementById('btn-save-thresholds');
            
            try {
                // Get recommended threshold from tuner logs
                const logRes = await fetch(API_BASE + `/api/logs?name=run_tuner.log`);
                let recommendedThreshold = null;
                if (logRes.ok) {
                    const logText = await logRes.text();
                    
                    const thrMatch = logText.match(/threshold:\s*([0-9.]+)/);
                    const freqMatch = logText.match(/signals_per_day:\s*([0-9.]+)/);
                    const sharpeMatch = logText.match(/sharpe:\s*([0-9.-]+)/);
                    const precMatch = logText.match(/precision:\s*([0-9.-]+)/);
                    
                    if (thrMatch) {
                        recommendedThreshold = parseFloat(thrMatch[1]);
                        const recommendedFreq = freqMatch ? parseFloat(freqMatch[1]).toFixed(2) : '—';
                        const recommendedSharpe = sharpeMatch ? parseFloat(sharpeMatch[1]).toFixed(2) : '—';
                        const recommendedPrec = precMatch ? (parseFloat(precMatch[1]) * 100).toFixed(1) + '%' : '—';
                        
                        if (tunerRec) {
                            tunerRec.innerHTML = `Рекомендуемый порог: <span class="text-purple-400 font-bold font-mono">${recommendedThreshold.toFixed(2)}</span>. Ожидается сигналов в день: <span class="text-white font-semibold font-mono">${recommendedFreq}</span>, Sharpe: <span class="text-emerald-400 font-semibold font-mono">${recommendedSharpe}</span>, Точность: <span class="text-sky-400 font-semibold font-mono">${recommendedPrec}</span>.`;
                        }
                        
                        if (tunerApplyBtn) {
                            tunerApplyBtn.disabled = false;
                            tunerApplyBtn.className = "bg-[#1A1A22] border border-[#2B2B36] text-gray-300 hover:text-white text-[10px] font-medium py-2 px-4 rounded-xl transition-all active:scale-[0.98] shadow-md flex items-center gap-1.5 cursor-pointer";
                            tunerApplyBtn.setAttribute('data-threshold', recommendedThreshold);
                        }
                    }
                }
                
                // Read grid scan results
                const dataPath = document.getElementById('liteagents-tuner-data-path').value;
                const pathBase = dataPath.substring(0, dataPath.lastIndexOf('.'));
                const scanCsvPath = `${pathBase}_thrscan.csv`;
                
                const csvRes = await fetch(API_BASE + `/api/data/preview?path=${scanCsvPath}&n=50`);
                if (csvRes.ok) {
                    const data = await csvRes.json();
                    if (tunerTbody && data.rows && data.rows.length > 0) {
                        tunerTbody.innerHTML = '';
                        
                        // Sort rows by threshold
                        data.rows.sort((a, b) => parseFloat(a.threshold) - parseFloat(b.threshold));
                        
                        data.rows.forEach(r => {
                            const isBest = recommendedThreshold && Math.abs(parseFloat(r.threshold) - recommendedThreshold) < 0.005;
                            const tr = document.createElement('tr');
                            if (isBest) {
                                tr.className = "bg-purple-950/20 text-purple-300 font-bold border-l-2 border-purple-500";
                            } else {
                                tr.className = "hover:bg-[#1A1A22]/30";
                            }
                            
                            const valSPerDay = parseFloat(r.signals_per_day || r.signals_count / 10 || 0).toFixed(2);
                            const valSharpe = parseFloat(r.sharpe || 0).toFixed(2);
                            const valPrec = parseFloat(r.precision || 0);
                            const pctPrec = !isNaN(valPrec) ? (valPrec * 100).toFixed(1) + '%' : '—';
                            
                            tr.innerHTML = `
                                <td class="p-2 py-1.5">${parseFloat(r.threshold).toFixed(2)}</td>
                                <td class="p-2 py-1.5">${valSPerDay}</td>
                                <td class="p-2 py-1.5 text-emerald-400">${valSharpe}</td>
                                <td class="p-2 py-1.5 text-sky-400">${pctPrec}</td>
                            `;
                            tunerTbody.appendChild(tr);
                        });
                    }
                }
            } catch (err) {
                console.error("Error loading tuner results:", err);
            }
        }

        async function saveTunedThresholds() {
            const btn = document.getElementById('btn-save-thresholds');
            if (!btn) return;
            
            const thrVal = parseFloat(btn.getAttribute('data-threshold'));
            if (isNaN(thrVal)) return;
            
            try {
                // Get active sandbox config
                const configPath = getActiveSandboxConfigPath();
                const getRes = await fetch(API_BASE + `/api/yaml/get?path=${configPath}`);
                if (!getRes.ok) {
                    showActionToast('❌ Не удалось прочитать конфигурацию: ' + getRes.statusText);
                    return;
                }
                
                const yamlData = await getRes.json();
                
                // Parse and update YAML thresholds using simple string substitution to preserve comments/layout
                let content = yamlData.content;
                
                // Check components:policy:params:enter_threshold
                if (content.indexOf('enter_threshold:') !== -1) {
                    content = content.replace(/enter_threshold:\s*[0-9.]+/g, `enter_threshold: ${thrVal.toFixed(2)}`);
                } else {
                    // Try to inject under policy params
                    const policyIdx = content.indexOf('policy:');
                    if (policyIdx !== -1) {
                        const nextLineIdx = content.indexOf('\n', policyIdx);
                        content = content.substring(0, nextLineIdx + 1) + "      params:\n        enter_threshold: " + thrVal.toFixed(2) + "\n" + content.substring(nextLineIdx + 1);
                    }
                }
                
                // Save config
                const saveRes = await fetch(API_BASE + `/api/yaml/save`, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        path: configPath,
                        content: content
                    })
                });
                
                if (saveRes.ok) {
                    showActionToast(`✅ Рекомендуемый порог ${thrVal.toFixed(2)} сохранен в ${configPath}!`);
                } else {
                    showActionToast('❌ Не удалось сохранить конфигурацию.');
                }
            } catch (err) {
                showActionToast('❌ Ошибка сети: ' + err.message);
            }
        }

