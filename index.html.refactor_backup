                        </h4>
                        <p class="text-[9px] text-gray-500 leading-relaxed max-w-xl font-sans">${step.desc}</p>
                        ${actionHtml}
                    </div>
                `;

                if (index === currentStep) {
                    const btn = stepEl.querySelector('button');
                    if (btn) {
                        btn.onclick = step.action;
                    }
                }

                container.appendChild(stepEl);
