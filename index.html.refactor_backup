        function submitFeaturesConfig() {
            const asset = activeAsset;
            const in_path = document.getElementById('feat-in').value;
            const out_path = document.getElementById('feat-out').value;
            const price_col = document.getElementById('feat-price-col').value;
            const lookbacks = document.getElementById('feat-lookbacks').value;
            
            const params = {
                in: in_path,
                out: out_path,
                price_col: price_col,
                lookbacks: lookbacks
            };
            
            // Get optional bar duration
            const barDurationEl = document.getElementById('feat-bar-duration');
            if (barDurationEl) {
                params.bar_duration_minutes = parseInt(barDurationEl.value) || 240;
            }
            
            // Get optional RSI period
            const rsiPeriodEl = document.getElementById('feat-rsi-period');
            if (rsiPeriodEl) {
                params.rsi_period = parseInt(rsiPeriodEl.value) || 14;
            }
            
            // Scrape selected features
            const checkedFeatures = [];
            const grid = document.getElementById('features-checkbox-grid');
            if (grid) {
                grid.querySelectorAll('input[type="checkbox"]:checked').forEach(cb => {
                    checkedFeatures.push(cb.value);
                });
            }
            params.selected_features = checkedFeatures.join(',');
            
            if (asset === 'equity') {
                const useParkinson = document.getElementById('feat-use-parkinson')?.checked;
                const useYangZhang = document.getElementById('feat-use-yangzhang')?.checked;
                if (useParkinson) {
                    params.parkinson_windows = document.getElementById('feat-parkinson-windows').value;
                    params.high_col = "high";
                    params.low_col = "low";
