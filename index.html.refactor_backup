        function toggleAccordion(id, btn) {
            const el = document.getElementById(id);
            const chevron = btn.querySelector('.fa-chevron-down');
            if (el.classList.contains('hidden')) {
                el.classList.remove('hidden');
                if (chevron) chevron.classList.add('rotate-180');
            } else {
                el.classList.add('hidden');
                if (chevron) chevron.classList.remove('rotate-180');
            }
        }

        function closeTrainingConfig() {
            const modal = document.getElementById('training-config-modal');
            modal.classList.add('opacity-0');
            modal.querySelector('div').classList.remove('scale-100');
            modal.querySelector('div').classList.add('scale-95');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }

        function submitTrainingConfig() {
            const asset = activeAsset;
            const config = document.getElementById('train-config-file').value;
            const steps = parseInt(document.getElementById('train-steps').value) || 2000000;
            const envs = parseInt(document.getElementById('train-envs').value) || 4;
            const lr = parseFloat(document.getElementById('train-lr').value) || 0.0001;
            const split = document.getElementById('train-split').value;
            const regime = document.getElementById('train-regime-config').value;
            const seasonality = document.getElementById('train-seasonality-config').value;
            const offline = document.getElementById('train-offline-config').value;
            const tb = document.getElementById('train-tb-dir').value;

            // Contents from textareas
            const regime_content = document.getElementById('train-regime-content').value;
            const seasonality_content = document.getElementById('train-seasonality-content').value;
            const offline_content = document.getElementById('train-offline-content').value;
            const train_config_content = document.getElementById('train-main-config-content').value;

            const params = {
                config: config,
                total_timesteps: steps,
                n_envs: envs,
                learning_rate: lr,
                dataset_split: split,
                regime_config: regime,
                liquidity_seasonality: seasonality,
                offline_config: offline,
                tensorboard_log_dir: tb,
                regime_config_content: regime_content,
                liquidity_seasonality_content: seasonality_content,
                offline_config_content: offline_content,
                train_config_content: train_config_content
            };

            // Save to localStorage for dynamic telemetry tracking
            try {
                localStorage.setItem('rivenquant_config_train_' + asset, JSON.stringify(params));
            } catch (e) {
                console.error("Error saving train params:", e);
            }

            closeTrainingConfig();

            runQuickAction('run_job', {
                job: 'run_train',
                params: params
            });
        }

