        async function runCoderEvaluation(capital) {
            const consoleEl = document.getElementById('coder-log-container');
            const logPre = consoleEl.querySelector('pre');
            logPre.innerText += "\n[SYSTEM] Расчет аналитических метрик и кривой доходности...\n";
            consoleEl.scrollTop = consoleEl.scrollHeight;
            
            try {
                const evalRes = await fetch(API_BASE + '/api/run_job', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        job: 'run_eval',
                        params: {
                            capital_base: capital,
                            rf_annual: 0.0
                        }
                    })
                });
                
                if (evalRes.ok) {
                    setTimeout(async () => {
                        try {
                            const resResults = await fetch(API_BASE + '/api/eval/results');
                            if (resResults.ok) {
                                const resData = await resResults.json();
                                const eq = resData.equity || {};
                                const tr = resData.trades || {};
                                
                                let grossProfit = parseFloat(tr.gross_profit) || 0.0;
                                let grossLoss = parseFloat(tr.gross_loss) || 0.0;
                                let profitFactor = "—";
                                if (grossLoss > 0) {
                                    profitFactor = (grossProfit / grossLoss).toFixed(2);
                                } else if (grossProfit > 0) {
                                    profitFactor = "∞";
                                }
                                
                                const fmtPct = (v) => {
                                    if (v === undefined || v === null || isNaN(v)) return '—';
                                    return (v * 100).toFixed(2) + '%';
                                };
                                const fmtVal = (v, d = 2) => {
                                    if (v === undefined || v === null || isNaN(v)) return '—';
                                    return v.toFixed(d);
                                };
                                
                                document.getElementById('coder-res-sharpe').innerText = fmtVal(eq.sharpe_ratio);
                                document.getElementById('coder-res-maxdd').innerText = fmtPct(eq.max_drawdown);
                                document.getElementById('coder-res-return').innerText = fmtPct(eq.total_return);
                                document.getElementById('coder-res-winrate').innerText = fmtPct(tr.win_rate);
                                document.getElementById('coder-res-trades').innerText = tr.total_trades !== undefined ? tr.total_trades : '—';
                                document.getElementById('coder-res-pf').innerText = profitFactor;
                                
                                const chart = document.getElementById('coder-eval-chart');
                                chart.src = API_BASE + '/api/image?path=logs/equity.png&t=' + Date.now();
                                chart.onload = () => {
                                    document.getElementById('coder-chart-spinner').classList.add('hidden');
                                    chart.classList.remove('opacity-0');
                                    chart.classList.add('opacity-100');
                                };
                                
                                document.getElementById('coder-results-status').innerText = "Готово";
                                showActionToast("Бэктест и оценка успешно завершены!");
                                logPre.innerText += "\n[SYSTEM] Результаты бэктеста обновлены.\n";
                                consoleEl.scrollTop = consoleEl.scrollHeight;
                            } else {
                                logPre.innerText += "\n[ERROR] Не удалось загрузить результаты расчетов.\n";
                                document.getElementById('coder-results-status').innerText = "Ошибка";
                                document.getElementById('coder-chart-spinner').classList.add('hidden');
                            }
                        } catch(e) {
                            console.error("Error loading eval results:", e);
                            document.getElementById('coder-results-status').innerText = "Ошибка";
                            document.getElementById('coder-chart-spinner').classList.add('hidden');
                        }
                    }, 1000);
                } else {
                    logPre.innerText += "\n[ERROR] Не удалось запустить оценку метрик.\n";
                    document.getElementById('coder-results-status').innerText = "Ошибка";
                    document.getElementById('coder-chart-spinner').classList.add('hidden');
                }
            } catch (err) {
                logPre.innerText += `\n[ERROR] Ошибка сети при оценке: ${err.message}\n`;
                document.getElementById('coder-results-status').innerText = "Ошибка";
                document.getElementById('coder-chart-spinner').classList.add('hidden');
            }
            
            resetCoderBacktestUI();
        }

