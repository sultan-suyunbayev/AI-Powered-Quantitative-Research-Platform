        // UI Router
        function switchModule(moduleId) {
            // Intercept if in Lite mode and trying to access Pro modules
            if (currentProductMode === 'lite' && moduleId !== 'home' && !moduleId.startsWith('lite-')) {
                openProFeatureModal(moduleId);
                return;
            }

            // Remove active classes from all sidebar buttons
            const buttons = document.querySelectorAll('#sidebar-nav button');
            buttons.forEach(btn => {
                btn.classList.remove('bg-[#1E1F24]', 'text-white', 'font-medium', 'border-l-2', 'border-blue-500', 'px-2.5');
                btn.classList.add('text-gray-400');
            });

            // Activate current button
            const activeBtn = document.getElementById(`btn-${moduleId}`);
            if (activeBtn) {
                activeBtn.classList.remove('text-gray-400');
                activeBtn.classList.add('bg-[#1E1F24]', 'text-white', 'font-medium', 'border-l-2', 'border-blue-500', 'px-2.5');
