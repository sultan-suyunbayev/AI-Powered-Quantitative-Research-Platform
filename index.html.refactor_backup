        function applyLiteHistoryFilters() {
            const agentFilter = document.getElementById('litehistory-filter-agent').value;
            const periodFilter = document.getElementById('litehistory-filter-period').value;
            const searchVal = document.getElementById('litehistory-search').value.toLowerCase().trim();

            const filteredTrades = allLiteTrades.filter(t => {
                if (searchVal && !t.symbol.toLowerCase().includes(searchVal)) {
                    return false;
                }

                if (agentFilter !== 'all') {
                    const agentId = (t.meta && t.meta.agent_id) ? t.meta.agent_id : '';
                    if (agentFilter === 'Agent_PPO') {
                        if (!agentId.includes('Agent_PPO')) return false;
                    } else if (agentFilter === 'Manual_Trade') {
                        if (agentId && agentId !== 'Manual_Trade') return false;
                    }
                }

                if (periodFilter !== 'all') {
                    const diffMs = Date.now() - t.ts;
                    if (periodFilter === '24h' && diffMs > 24 * 3600 * 1000) return false;
                    if (periodFilter === '7d' && diffMs > 7 * 24 * 3600 * 1000) return false;
                }

                return true;
            });

            displayedTrades = filteredTrades;
            renderLiteHistoryKPIs(filteredTrades);
            renderLiteHistoryTable(filteredTrades);
        }

        function renderLiteHistoryKPIs(tradesList) {
            let totalSlippage = 0;
            let totalFees = 0;
            let totalLatency = 0;
            let web3GasEth = 0;

            let slipCount = 0;
            let latencyCount = 0;

            tradesList.forEach(t => {
                if (t.slippage !== undefined && t.slippage !== null) {
                    totalSlippage += t.slippage;
                    slipCount++;
                }
                if (t.fee !== undefined && t.fee !== null) {
                    if (t.fee_asset === 'USDT' || t.fee_asset === 'USDC' || t.fee_asset === 'USD') {
                        totalFees += t.fee;
                    } else {
                        const symbol = t.symbol || '';
                        totalFees += t.fee * (symbol.includes('BTC') ? 68000 : 3800);
                    }
                }
                if (t.latency !== undefined && t.latency !== null) {
                    totalLatency += t.latency;
                    latencyCount++;
                }
                if (t.meta && t.meta.gas_used) {
                    const gasUsed = parseFloat(t.meta.gas_used) || 0;
                    const gasPrice = parseFloat(t.meta.gas_price_gwei) || 0;
                    web3GasEth += (gasUsed * gasPrice) / 1e9;
                }
            });

            const avgSlippage = slipCount > 0 ? (totalSlippage / slipCount) : 0.12;
            const avgLatency = latencyCount > 0 ? (totalLatency / latencyCount) : 45;

            document.getElementById('litehistory-kpi-slippage').innerText = avgSlippage.toFixed(2) + ' bps';
            document.getElementById('litehistory-kpi-fees').innerText = '$' + totalFees.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
            document.getElementById('litehistory-kpi-latency').innerText = Math.round(avgLatency) + ' ms';
            document.getElementById('litehistory-kpi-gas').innerText = web3GasEth.toFixed(4) + ' ETH';
        }

        function renderLiteHistoryTable(tradesList) {
            const tbody = document.getElementById('litehistory-tbody');
            if (!tbody) return;

            if (tradesList.length === 0) {
                tbody.innerHTML = `<tr><td colspan="8" class="p-4 text-center text-gray-500 font-mono">Сделок не найдено</td></tr>`;
                return;
            }

            tbody.innerHTML = tradesList.map((t, index) => {
                const dateStr = t.ts ? new Date(t.ts).toLocaleTimeString() : '—';
                const sideColor = t.side === 'BUY' ? 'text-emerald-400 bg-emerald-500/10' : 'text-rose-400 bg-rose-500/10';
                
                let linkHTML = '—';
                if (t.meta && t.meta.tx_hash) {
                    const shortHash = t.meta.tx_hash.slice(0, 6) + '...' + t.meta.tx_hash.slice(-4);
                    linkHTML = `<a href="https://etherscan.io/tx/${t.meta.tx_hash}" target="_blank" class="text-pink-400 hover:underline flex items-center justify-end gap-1"><i class="fa-solid fa-arrow-up-right-from-square text-[9px]"></i>${shortHash}</a>`;
                } else if (t.meta && t.meta.agent_id) {
                    linkHTML = `<span class="text-indigo-400 font-bold">${t.meta.agent_id}</span>`;
                }

                const slipVal = (t.slippage !== undefined && t.slippage !== null) ? t.slippage : 0;
                const slippageColor = slipVal > 0.25 ? 'text-rose-400' : 'text-gray-400';
                const qtyVal = (t.quantity !== undefined && t.quantity !== null) ? t.quantity : 0;
                const priceVal = (t.price !== undefined && t.price !== null) ? t.price : 0;
                const feeVal = (t.fee !== undefined && t.fee !== null) ? t.fee : 0;

                return `
                    <tr onclick="openLiteHistoryAuditor(${index})" class="hover:bg-[#1A1A22]/40 transition-colors cursor-pointer border-b border-[#232329]/20">
                        <td class="p-3 text-gray-500">${dateStr}</td>
                        <td class="p-3 font-bold text-white">${t.symbol || '—'}</td>
                        <td class="p-3"><span class="px-2 py-0.5 rounded text-[10px] font-bold ${sideColor}">${t.side || 'BUY'}</span></td>
                        <td class="p-3 text-right text-gray-300 font-bold">${qtyVal.toLocaleString()}</td>
                        <td class="p-3 text-right text-white font-bold">${priceVal.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}</td>
                        <td class="p-3 text-right ${slippageColor}">${slipVal.toFixed(2)} bps</td>
                        <td class="p-3 text-right text-gray-400">${feeVal > 0 ? (feeVal.toFixed(2) + ' ' + (t.fee_asset || 'USD')) : '0.00'}</td>
                        <td class="p-3 text-right">${linkHTML}</td>
                    </tr>
                `;
            }).join('');
        }

