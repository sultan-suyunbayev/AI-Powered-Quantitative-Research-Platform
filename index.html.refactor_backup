            const logitHoldEl = document.getElementById('auditor-logit-hold');
            const logitSellEl = document.getElementById('auditor-logit-sell');
            const riskStatusEl = document.getElementById('auditor-risk-status');

            const meta = trade.meta || {};
            agentIdEl.innerText = meta.agent_id || 'Manual Trade / Direct EXEC';
            featuresEl.innerText = JSON.stringify(meta.features || { "manual": true }, null, 2);

            const logits = meta.logits || [0.33, 0.34, 0.33];
            logitBuyEl.innerText = (logits[0] * 100).toFixed(0) + '%';
            logitHoldEl.innerText = (logits[1] * 100).toFixed(0) + '%';
            logitSellEl.innerText = (logits[2] * 100).toFixed(0) + '%';

            riskStatusEl.innerText = meta.risk_check || 'PASSED';
            
            drawer.classList.remove('hidden');
            setTimeout(() => {
