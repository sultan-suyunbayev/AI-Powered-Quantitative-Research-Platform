            if (asset === 'equity') {
                return type === 'sandbox' ? 'configs/config_backtest_stocks.yaml' :
                       type === 'train' ? 'configs/config_train_stocks.yaml' :
                       type === 'realtime' ? 'configs/config_live_alpaca.yaml' : 'configs/ingest.yaml';
